<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:ThIDE.Converters"
        xmlns:l="using:ThIDE.Resources"
        x:Class="ThIDE.Views.PreferencesWindow"
        x:CompileBindings="False"
        Title="{l:Loc Pref_Title}"
        Width="1080" Height="858"
        MinWidth="640" MinHeight="460"
        AutomationProperties.AutomationId="Preferences.Window"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Footer: OK / Cancel -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button AutomationProperties.AutomationId="Preferences.Cancel" Content="{l:Loc Common_Cancel}" Click="OnCancel" MinWidth="80" />
                <Button AutomationProperties.AutomationId="Preferences.Ok" Content="{l:Loc Common_Ok}" Click="OnOk" IsDefault="True" MinWidth="80" />
            </StackPanel>
        </Border>

        <!-- Left rail: search box + section list (VS2026-style options navigation). -->
        <Border DockPanel.Dock="Left" Width="200"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8">
                <TextBox DockPanel.Dock="Top" Watermark="{l:Loc Pref_SearchWm}" Margin="0,0,0,8"
                         AutomationProperties.AutomationId="Preferences.Search" AutomationProperties.Name="{l:Loc Pref_SearchWm}"
                         Text="{Binding SearchQuery, Mode=TwoWay}" />
                <ListBox ItemsSource="{Binding Sections}"
                         AutomationProperties.AutomationId="Preferences.Sections"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right pane: the selected section's settings. Horizontal scrolling is disabled so every
             section (notably the Keyboard Shortcuts / File Associations grids) is constrained to the
             pane width and its star columns fit to the available width instead of overflowing. -->
        <ScrollViewer AutomationProperties.AutomationId="Preferences.Content" Padding="18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- General -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.General" Spacing="10" IsVisible="{Binding IsGeneral}">
                    <TextBlock Text="{l:Loc Pref_General}" FontSize="16" FontWeight="Bold" />
                    <CheckBox Content="{l:Loc Pref_ReopenSession}"
                              AutomationProperties.AutomationId="Preferences.ReopenSession"
                              IsChecked="{Binding RestoreSessionOnStartup}" />
                    <CheckBox Content="{l:Loc Pref_ShowWelcome}"
                              AutomationProperties.AutomationId="Preferences.ShowWelcome"
                              IsChecked="{Binding ShowWelcomeOnStartup}" />
                    <TextBlock Text="{l:Loc Pref_ProjectConfig}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <RadioButton GroupName="ProjectConfig" Content="{l:Loc Pref_ProjectConfigFolder}"
                                 AutomationProperties.AutomationId="Preferences.ProjectConfig.Folder"
                                 IsChecked="{Binding !ProjectConfigInAppData}" />
                    <TextBlock Text="{l:Loc Pref_ProjectConfigFolderHint}" Foreground="Gray" FontSize="11" Margin="28,-6,0,0" TextWrapping="Wrap" />
                    <RadioButton GroupName="ProjectConfig" Content="{l:Loc Pref_ProjectConfigAppData}"
                                 AutomationProperties.AutomationId="Preferences.ProjectConfig.AppData"
                                 IsChecked="{Binding ProjectConfigInAppData}" />
                    <TextBlock Text="{l:Loc Pref_ProjectConfigAppDataHint}" Foreground="Gray" FontSize="11" Margin="28,-6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="{l:Loc Pref_Language}" VerticalAlignment="Center" Width="100" />
                        <ComboBox AutomationProperties.AutomationId="Preferences.Language" AutomationProperties.Name="{l:Loc Pref_Language}" MinWidth="180" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem>English</ComboBoxItem>
                            <ComboBoxItem>Română</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{l:Loc Pref_LanguageHelp}"
                               Foreground="Gray" FontSize="11" />
                    <Separator Margin="0,6" />
                    <!-- configurable auto-save. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="{l:Loc Pref_AutoSave}" VerticalAlignment="Center" Width="100" />
                        <ComboBox AutomationProperties.AutomationId="Preferences.AutoSaveMode" AutomationProperties.Name="{l:Loc Pref_AutoSave}" MinWidth="180" SelectedIndex="{Binding AutoSaveModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{l:Loc Pref_AutoSaveOff}" />
                            <ComboBoxItem Content="{l:Loc Pref_AutoSaveDelay}" />
                            <ComboBoxItem Content="{l:Loc Pref_AutoSaveFocus}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{l:Loc Pref_DelaySeconds}" VerticalAlignment="Center" Width="100" />
                        <NumericUpDown Minimum="5" Maximum="3600" Increment="5" MinWidth="120"
                                       AutomationProperties.AutomationId="Preferences.AutoSaveDelay" AutomationProperties.Name="{l:Loc Pref_DelaySeconds}"
                                       Value="{Binding AutoSaveDelaySeconds, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{l:Loc Pref_AutoSaveHelp}"
                               Foreground="Gray" FontSize="11" />
                    <Separator Margin="0,6" />
                    <!-- opt-in, local-only telemetry / crash reports. -->
                    <CheckBox Content="{l:Loc Pref_Telemetry}"
                              AutomationProperties.AutomationId="Preferences.Telemetry"
                              IsChecked="{Binding TelemetryEnabled}" />
                    <TextBlock Text="{l:Loc Pref_TelemetryHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Theme & Colors (#2) -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Theme" Spacing="10" IsVisible="{Binding IsTheme}">
                    <TextBlock Text="{l:Loc Pref_Theme}" FontSize="16" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{l:Loc Pref_AppTheme}" VerticalAlignment="Center" Width="120" />
                        <ComboBox AutomationProperties.AutomationId="Preferences.Theme" AutomationProperties.Name="{l:Loc Pref_AppTheme}" MinWidth="200" SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{l:Loc Pref_ThemeSystem}" />
                            <ComboBoxItem Content="{l:Loc Pref_ThemeLight}" />
                            <ComboBoxItem Content="{l:Loc Pref_ThemeDark}" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{l:Loc Pref_ThemeHelp}"
                               Foreground="Gray" FontSize="11" />

                    <Separator Margin="0,6" />
                    <CheckBox Content="{l:Loc Pref_CustomColors}"
                              AutomationProperties.AutomationId="Preferences.CustomColors"
                              IsChecked="{Binding UseCustomSyntaxColors}" />
                    <TextBlock Text="{l:Loc Pref_CustomColorsHelp}"
                               Foreground="Gray" FontSize="11" />
                    <Grid ColumnDefinitions="120,150,28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          IsEnabled="{Binding UseCustomSyntaxColors}">
                        <Grid.Styles>
                            <Style Selector="TextBlock.lbl"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
                            <Style Selector="TextBox.hex"><Setter Property="Margin" Value="0,0,8,6" /></Style>
                            <Style Selector="Border.swatch"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="BorderBrush" Value="Gray" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="3" /></Style>
                        </Grid.Styles>
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynKeyword}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.Keyword" AutomationProperties.Name="{l:Loc Pref_SynKeyword}"    Grid.Row="0" Grid.Column="1" Classes="hex" Text="{Binding SyntaxKeywordColor}" />
                        <Border     Grid.Row="0" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxKeywordColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynIdentifier}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.Identifier" AutomationProperties.Name="{l:Loc Pref_SynIdentifier}"    Grid.Row="1" Grid.Column="1" Classes="hex" Text="{Binding SyntaxIdentifierColor}" />
                        <Border     Grid.Row="1" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxIdentifierColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynNumber}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.Number" AutomationProperties.Name="{l:Loc Pref_SynNumber}"    Grid.Row="2" Grid.Column="1" Classes="hex" Text="{Binding SyntaxNumberColor}" />
                        <Border     Grid.Row="2" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxNumberColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynString}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.String" AutomationProperties.Name="{l:Loc Pref_SynString}"    Grid.Row="3" Grid.Column="1" Classes="hex" Text="{Binding SyntaxStringColor}" />
                        <Border     Grid.Row="3" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxStringColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynComment}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.Comment" AutomationProperties.Name="{l:Loc Pref_SynComment}"    Grid.Row="4" Grid.Column="1" Classes="hex" Text="{Binding SyntaxCommentColor}" />
                        <Border     Grid.Row="4" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxCommentColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynOption}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.Option" AutomationProperties.Name="{l:Loc Pref_SynOption}"    Grid.Row="5" Grid.Column="1" Classes="hex" Text="{Binding SyntaxOptionColor}" />
                        <Border     Grid.Row="5" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxOptionColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="lbl" Text="{l:Loc Pref_SynPunctuation}" />
                        <TextBox AutomationProperties.AutomationId="Preferences.SyntaxColor.Punctuation" AutomationProperties.Name="{l:Loc Pref_SynPunctuation}"    Grid.Row="6" Grid.Column="1" Classes="hex" Text="{Binding SyntaxPunctuationColor}" />
                        <Border     Grid.Row="6" Grid.Column="2" Classes="swatch" Background="{Binding SyntaxPunctuationColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
                    </Grid>
                </StackPanel>

                <!-- Editor -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Editor" Spacing="10" IsVisible="{Binding IsEditor}">
                    <TextBlock Text="{l:Loc Pref_Editor}" FontSize="16" FontWeight="Bold" />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_FontSize}"
                                   VerticalAlignment="Center" Margin="0,0,8,6" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="8" Maximum="32" Increment="1"
                                       AutomationProperties.AutomationId="Preferences.FontSize" AutomationProperties.Name="{l:Loc Pref_FontSize}"
                                       Value="{Binding EditorFontSize}" Margin="0,0,0,6" MaxWidth="160"
                                       HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Pref_IndentSize}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="8" Increment="1"
                                       AutomationProperties.AutomationId="Preferences.IndentSize" AutomationProperties.Name="{l:Loc Pref_IndentSize}"
                                       Value="{Binding IndentationSize}" MaxWidth="160" HorizontalAlignment="Left" />
                    </Grid>
                    <CheckBox AutomationProperties.AutomationId="Preferences.ShowLineNumbers" Content="{l:Loc Pref_ShowLineNumbers}" IsChecked="{Binding ShowLineNumbers}" />
                    <CheckBox AutomationProperties.AutomationId="Preferences.HighlightCurrentLine" Content="{l:Loc Pref_HighlightCurrentLine}" IsChecked="{Binding HighlightCurrentLine}" />
                    <CheckBox AutomationProperties.AutomationId="Preferences.ConvertTabs" Content="{l:Loc Pref_ConvertTabs}" IsChecked="{Binding ConvertTabsToSpaces}" />
                    <CheckBox Content="{l:Loc Pref_RenamePreview}"
                              AutomationProperties.AutomationId="Preferences.RenamePreview"
                              IsChecked="{Binding ShowRenamePreviewBeforeApply}" />
                    <CheckBox Content="{l:Loc Pref_FormatOnSave}"
                              AutomationProperties.AutomationId="Preferences.FormatOnSave"
                              IsChecked="{Binding FormatOnSave}" />
                    <CheckBox Content="{l:Loc Pref_ValidateOnType}"
                              AutomationProperties.AutomationId="Preferences.ValidateOnType"
                              IsChecked="{Binding ValidateOnType}" />
                    <TextBlock Text="{l:Loc Pref_ValidateOnTypeHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />
                    <CheckBox Content="{l:Loc Pref_DoubleClickNav}"
                              AutomationProperties.AutomationId="Preferences.DoubleClickNavigate"
                              IsChecked="{Binding RequireDoubleClickToNavigate}" />
                    <TextBlock Text="{l:Loc Pref_DoubleClickNavHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />
                </StackPanel>

                <!-- Editor Features -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.EditorFeatures" Spacing="8" IsVisible="{Binding IsEditorFeatures}">
                    <TextBlock Text="{l:Loc Pref_EditorFeatures}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{l:Loc Pref_EditorFeaturesHelp}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <!-- The feature list can be longer than the window; give it its own scroll so
                         every row stays reachable (#3). MaxHeight tracks the window height. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="{Binding $parent[Window].Bounds.Height, Converter={x:Static conv:RatioConverter.Instance}, ConverterParameter=0.70}">
                    <ItemsControl AutomationProperties.AutomationId="Preferences.EditorFeatures" ItemsSource="{Binding EditorFeatureRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                  VerticalAlignment="Top" Margin="0,2,8,0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsCompiledIn}" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}"
                                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Performance / large-file guards (#10) -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Performance" Spacing="10" IsVisible="{Binding IsPerformance}">
                    <TextBlock Text="{l:Loc Pref_Performance}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{l:Loc Pref_PerfHelp1}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_MaxHighlightLines}"
                                   VerticalAlignment="Center" Margin="0,0,8,6" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1000" Maximum="2000000" Increment="1000"
                                       AutomationProperties.AutomationId="Preferences.MaxHighlightLines" AutomationProperties.Name="{l:Loc Pref_MaxHighlightLines}"
                                       Value="{Binding MaxHighlightLines}" Margin="0,0,0,6" MaxWidth="180"
                                       HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Pref_MaxHighlightKB}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="64" Maximum="1048576" Increment="128"
                                       AutomationProperties.AutomationId="Preferences.MaxHighlightKB" AutomationProperties.Name="{l:Loc Pref_MaxHighlightKB}"
                                       Value="{Binding MaxHighlightKB}" MaxWidth="180" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Text="{l:Loc Pref_PerfHelp2}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_MaxParseLines}"
                                   VerticalAlignment="Center" Margin="0,0,8,6" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1000" Maximum="2000000" Increment="1000"
                                       AutomationProperties.AutomationId="Preferences.MaxParseLines" AutomationProperties.Name="{l:Loc Pref_MaxParseLines}"
                                       Value="{Binding MaxParseLines}" Margin="0,0,0,6" MaxWidth="180"
                                       HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Pref_MaxParseKB}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="64" Maximum="1048576" Increment="128"
                                       AutomationProperties.AutomationId="Preferences.MaxParseKB" AutomationProperties.Name="{l:Loc Pref_MaxParseKB}"
                                       Value="{Binding MaxParseKB}" MaxWidth="180" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Text="{l:Loc Pref_PerfHelp3}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_MaxStations}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="100" Maximum="1000000" Increment="500"
                                       AutomationProperties.AutomationId="Preferences.StationSearchLimit" AutomationProperties.Name="{l:Loc Pref_MaxStations}"
                                       Value="{Binding StationSearchLimit}" MaxWidth="180" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Text="{l:Loc Pref_PerfHelp4}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_StartupTimeout}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="600" Increment="5"
                                       AutomationProperties.AutomationId="Preferences.StartupTimeout" AutomationProperties.Name="{l:Loc Pref_StartupTimeout}"
                                       Value="{Binding StartupLoadTimeoutSeconds}" MaxWidth="180" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>

                <!-- Workspace -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Workspace" Spacing="10" IsVisible="{Binding IsWorkspace}">
                    <TextBlock Text="{l:Loc Pref_Workspace}" FontSize="16" FontWeight="Bold" />
                    <CheckBox Content="{l:Loc Pref_ReloadExternal}"
                              AutomationProperties.AutomationId="Preferences.ReloadExternalChanges"
                              IsChecked="{Binding AutoReloadExternalChanges}" />
                    <CheckBox Content="{l:Loc Pref_UpdateGraph}"
                              AutomationProperties.AutomationId="Preferences.UpdateGraphOnExternalChange"
                              IsChecked="{Binding AutoReloadGraphOnExternalChange}" />
                    <Separator Margin="0,6" />
                    <CheckBox Content="{l:Loc Pref_QuickOpenScope}"
                              AutomationProperties.AutomationId="Preferences.QuickOpenThconfigScope"
                              IsChecked="{Binding QuickOpenThconfigScope}" />
                    <TextBlock Text="{l:Loc Pref_QuickOpenHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Build & Output -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Build" Spacing="10" IsVisible="{Binding IsBuild}">
                    <TextBlock Text="{l:Loc Pref_Build}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{l:Loc Pref_AfterBuildOpen}" FontWeight="SemiBold" />
                    <CheckBox AutomationProperties.AutomationId="Preferences.OpenLoxAfterBuild" Content="{l:Loc Pref_OpenLox}" IsChecked="{Binding OpenLoxAfterBuild}" />
                    <CheckBox AutomationProperties.AutomationId="Preferences.Open3dAfterBuild" Content="{l:Loc Pref_Open3d}" IsChecked="{Binding Open3dAfterBuild}" />
                    <CheckBox AutomationProperties.AutomationId="Preferences.OpenPdfAfterBuild" Content="{l:Loc Pref_OpenPdf}" IsChecked="{Binding OpenPdfAfterBuild}" />
                    <TextBlock Text="{l:Loc Pref_OpenNoneHelp}" Foreground="Gray" FontSize="11" />
                    <CheckBox Content="{l:Loc Pref_OpenAll}"
                              AutomationProperties.AutomationId="Preferences.OpenAllOutputsAfterBuild"
                              IsChecked="{Binding OpenAllOutputsAfterBuild}" />
                    <Separator Margin="0,6" />
                    <!-- compile-on-save (off by default). -->
                    <CheckBox Content="{l:Loc Pref_CompileOnSave}"
                              AutomationProperties.AutomationId="Preferences.CompileOnSave"
                              IsChecked="{Binding CompileOnSave}" />
                    <TextBlock Text="{l:Loc Pref_CompileOnSaveHelp}"
                               Foreground="Gray" FontSize="11" />
                    <Separator Margin="0,6" />
                    <CheckBox Content="{l:Loc Pref_EnsureDirs}"
                              AutomationProperties.AutomationId="Preferences.EnsureOutputDirectories"
                              IsChecked="{Binding EnsureOutputDirectories}" />
                    <TextBlock Text="{l:Loc Pref_EnsureDirsHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    <CheckBox Content="{l:Loc Pref_AutoSaveBeforeCompile}"
                              AutomationProperties.AutomationId="Preferences.AutoSaveBeforeCompile"
                              IsChecked="{Binding AutoSaveBeforeCompile}" />
                    <TextBlock Text="{l:Loc Pref_AutoSaveBeforeCompileHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Visualization: per-feature enable/disable. -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Visualization" Spacing="10" IsVisible="{Binding IsVisualization}">
                    <TextBlock Text="{l:Loc Pref_Visualization}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{l:Loc Pref_VisualizationHelp}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <CheckBox Content="{l:Loc Pref_Vis_LivePreview}"
                              AutomationProperties.AutomationId="Preferences.EnableLivePreview"
                              IsChecked="{Binding EnableLivePreview}" />
                    <CheckBox Content="{l:Loc Pref_Vis_MapViewer}"
                              AutomationProperties.AutomationId="Preferences.EnableMapViewer"
                              IsChecked="{Binding EnableInAppViewer}" />
                    <CheckBox Content="{l:Loc Pref_Vis_PdfInternal}" Margin="20,0,0,0"
                              AutomationProperties.AutomationId="Preferences.OpenPdfInternal"
                              IsEnabled="{Binding EnableInAppViewer}"
                              IsChecked="{Binding OpenPdfInternal}" />
                    <CheckBox Content="{l:Loc Pref_Vis_MapAuto}"
                              AutomationProperties.AutomationId="Preferences.MapAutoPreview"
                              IsChecked="{Binding EnableMapAutoPreview}" />
                    <CheckBox Content="{l:Loc Pref_Vis_MapShowOnLoad}" Margin="20,0,0,0"
                              AutomationProperties.AutomationId="Preferences.MapShowOnLoad"
                              IsEnabled="{Binding EnableInAppViewer}"
                              IsChecked="{Binding AutoShowFirstMapOnLoad}" />
                    <CheckBox Content="{l:Loc Pref_Vis_Model3D}"
                              AutomationProperties.AutomationId="Preferences.EnableModel3D"
                              IsChecked="{Binding EnableModel3DViewer}" />
                    <CheckBox Content="{l:Loc Pref_Vis_Model3DInternal}" Margin="20,0,0,0"
                              AutomationProperties.AutomationId="Preferences.Open3dInternal"
                              IsEnabled="{Binding EnableModel3DViewer}"
                              IsChecked="{Binding Open3dInternal}" />
                    <CheckBox Content="{l:Loc Pref_Vis_Model3DAuto}"
                              AutomationProperties.AutomationId="Preferences.Model3DAutoPreview"
                              IsChecked="{Binding EnableModel3DAutoPreview}" />
                    <CheckBox Content="{l:Loc Pref_Vis_Structural}"
                              AutomationProperties.AutomationId="Preferences.EnableStructural"
                              IsChecked="{Binding EnableStructuralGeology}" />

                    <TextBlock Text="{l:Loc Pref_SurveyAnalytics}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{l:Loc Pref_SurveyAnalyticsHelp}"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <CheckBox Content="{l:Loc Pref_Analytics_Project}"
                              AutomationProperties.AutomationId="Preferences.ProjectAnalytics"
                              IsChecked="{Binding EnableProjectAnalytics}" />
                    <CheckBox Content="{l:Loc Pref_Analytics_ObjectBrowser}"
                              AutomationProperties.AutomationId="Preferences.ObjectBrowserEntities"
                              IsChecked="{Binding EnableObjectBrowserEntities}" />
                    <CheckBox Content="{l:Loc Pref_Analytics_Todo}"
                              AutomationProperties.AutomationId="Preferences.TodoScan"
                              IsChecked="{Binding EnableTodoScan}" />
                    <CheckBox Content="{l:Loc Pref_Analytics_Media}"
                              AutomationProperties.AutomationId="Preferences.MediaScan"
                              IsChecked="{Binding EnableMediaScan}" />
                    <CheckBox Content="{l:Loc Pref_AutoRecalcLeads}"
                              AutomationProperties.AutomationId="Preferences.AutoRecalcLeads"
                              IsChecked="{Binding AutoRecalcLeads}" />
                    <TextBlock Text="{l:Loc Pref_AutoRecalcLeadsHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />

                    <TextBlock Text="{l:Loc Pref_Diagnostics}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <CheckBox Content="{l:Loc Pref_Diag_LocalFixGrounds}"
                              AutomationProperties.AutomationId="Preferences.LocalFixGroundsDisconnected"
                              IsChecked="{Binding LocalFixGroundsDisconnected}" />
                    <TextBlock Text="{l:Loc Pref_Diag_LocalFixGroundsHelp}"
                               Foreground="Gray" TextWrapping="Wrap" Margin="20,0,0,0" />
                </StackPanel>

                <!-- External Tools (moved here from the dockable Settings panel, #13) -->
                <DockPanel AutomationProperties.AutomationId="Preferences.Section.ExternalTools" IsVisible="{Binding IsExternal}" VerticalAlignment="Top">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Pref_External}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                        <Button AutomationProperties.AutomationId="Preferences.ExternalTools.Refresh" Content="{l:Loc Common_Refresh}" Command="{Binding ExternalTools.RefreshCommand}" />
                        <TextBlock VerticalAlignment="Center" Foreground="Gray"
                                   Text="{Binding ExternalTools.Status}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ExternalTools.Tools}"
                              AutomationProperties.AutomationId="Preferences.ExternalTools.Grid" AutomationProperties.Name="{l:Loc Pref_External}"
                              x:CompileBindings="False" Height="440" VerticalAlignment="Top"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" CanUserSortColumns="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Tool}"     Binding="{Binding ToolId}"  Width="Auto" MinWidth="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Detected}" Binding="{Binding Path}"    Width="*"   MinWidth="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Version}"  Binding="{Binding Version}" Width="Auto" MinWidth="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Source}"   Binding="{Binding Source}"  Width="Auto" MinWidth="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Override}" Binding="{Binding OverridePath, Mode=TwoWay}" Width="Auto" MinWidth="160" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{l:Loc Common_Test}" Command="{Binding TestCommand}" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Result}"   Binding="{Binding TestResult}" Width="110" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Extensions (hooks, plugins) -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Extensions" Spacing="10" IsVisible="{Binding IsExtensions}">
                    <TextBlock Text="{l:Loc Pref_Extensions}" FontSize="16" FontWeight="Bold" />

                    <!-- scripting / macro hooks. -->
                    <CheckBox Content="{l:Loc Pref_ScriptHooks}"
                              AutomationProperties.AutomationId="Preferences.ScriptHooks"
                              IsChecked="{Binding EnableScriptHooks}" />
                    <TextBlock Text="{l:Loc Pref_ScriptHooksHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0"
                          IsEnabled="{Binding EnableScriptHooks}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_OnOpen}" VerticalAlignment="Center" />
                        <TextBox AutomationProperties.AutomationId="Preferences.HookOnOpen" AutomationProperties.Name="{l:Loc Pref_OnOpen}"   Grid.Row="0" Grid.Column="1" Text="{Binding HookOnOpen}" Watermark="{l:Loc Pref_CommandWm}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Pref_OnSave}" VerticalAlignment="Center" />
                        <TextBox AutomationProperties.AutomationId="Preferences.HookOnSave" AutomationProperties.Name="{l:Loc Pref_OnSave}"   Grid.Row="1" Grid.Column="1" Text="{Binding HookOnSave}" Watermark="{l:Loc Pref_CommandWm}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Loc Pref_OnBuild}" VerticalAlignment="Center" />
                        <TextBox AutomationProperties.AutomationId="Preferences.HookOnBuild" AutomationProperties.Name="{l:Loc Pref_OnBuild}"   Grid.Row="2" Grid.Column="1" Text="{Binding HookOnBuild}" Watermark="{l:Loc Pref_CommandWm}" />
                    </Grid>

                    <TextBlock Text="{l:Loc Pref_HookList}" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{l:Loc Pref_HookListHelp}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding HookRows}" IsEnabled="{Binding EnableScriptHooks}" AutomationProperties.AutomationId="Preferences.Hooks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="150,*,90,Auto,Auto,Auto" Margin="0,0,0,4">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding $parent[ItemsControl].DataContext.HookEvents}"
                                              SelectedItem="{Binding Event, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <TextBox Grid.Column="1" Text="{Binding Command, Mode=TwoWay}" Margin="4,0" Watermark="{l:Loc Pref_CommandWm}" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding TimeoutSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600"
                                                   ToolTip.Tip="{l:Loc Pref_HookTimeout}" FormatString="0" />
                                    <CheckBox Grid.Column="3" Content="{l:Loc Pref_HookDetached}" IsChecked="{Binding Detached, Mode=TwoWay}" Margin="6,0,0,0" />
                                    <CheckBox Grid.Column="4" Content="{l:Loc Pref_HookEnabled}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="6,0,0,0" />
                                    <Button Grid.Column="5" Content="✕" Margin="6,0,0,0"
                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveHookCommand}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{l:Loc Pref_HookAdd}" Command="{Binding AddHookCommand}" HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableScriptHooks}" AutomationProperties.AutomationId="Preferences.Hooks.Add" />

                    <CheckBox Content="{l:Loc Pref_ProjectAutomation}" IsChecked="{Binding EnableProjectAutomation}" Margin="0,6,0,0"
                              AutomationProperties.AutomationId="Preferences.ProjectAutomation" />
                    <TextBlock Text="{l:Loc Pref_ProjectAutomationHelp}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{l:Loc Pref_TrustedFolders}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding TrustedFolders}" AutomationProperties.AutomationId="Preferences.TrustedFolders">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="{l:Loc Pref_TrustRemove}"
                                            Command="{Binding $parent[ItemsControl].DataContext.RevokeTrustCommand}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,6" />
                    <!-- plugin assemblies. -->
                    <CheckBox Content="{l:Loc Pref_LoadPlugins}"
                              AutomationProperties.AutomationId="Preferences.LoadPlugins"
                              IsChecked="{Binding EnablePlugins}" />
                    <TextBlock Text="{l:Loc Pref_LoadPluginsHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />

                    <Separator Margin="0,6" />
                    <!-- MCP in-app server (loopback HTTP + token) for local LLM hosts. -->
                    <CheckBox Content="{l:Loc Pref_McpServer}"
                              AutomationProperties.AutomationId="Preferences.McpServer"
                              IsChecked="{Binding EnableMcpServer}" />
                    <TextBlock Text="{l:Loc Pref_McpServerHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    <!-- Follow the agent: allow the MCP action tools to drive the UI. -->
                    <CheckBox Content="{l:Loc Pref_McpFollowAgent}"
                              AutomationProperties.AutomationId="Preferences.McpFollowAgent"
                              IsChecked="{Binding McpFollowAgent}"
                              IsEnabled="{Binding EnableMcpServer}" Margin="16,0,0,0" />
                    <TextBlock Text="{l:Loc Pref_McpFollowAgentHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="16,0,0,0" />

                    <!-- Assistant pane (AI-07): the local OpenAI-compatible model the chat panel talks to. -->
                    <TextBlock Text="{l:Loc Pref_Assistant}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{l:Loc Pref_AssistantHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="16,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Pref_AssistantEndpoint}"
                                   VerticalAlignment="Center" Margin="0,0,8,4" />
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding AssistantEndpoint}"
                                   AutomationProperties.AutomationId="Preferences.AssistantEndpoint" AutomationProperties.Name="{l:Loc Pref_AssistantEndpoint}"
                                   Watermark="http://127.0.0.1:1234/v1" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Pref_AssistantModel}"
                                   VerticalAlignment="Center" Margin="0,0,8,4" />
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding AssistantModel}"
                                   AutomationProperties.AutomationId="Preferences.AssistantModel" AutomationProperties.Name="{l:Loc Pref_AssistantModel}"
                                   Watermark="qwen3-coder-30b-a3b-instruct" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Loc Pref_AssistantMaxTurns}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding AssistantMaxTurns}"
                                       AutomationProperties.AutomationId="Preferences.AssistantMaxTurns" AutomationProperties.Name="{l:Loc Pref_AssistantMaxTurns}"
                                       Minimum="1" Maximum="50" Increment="1" FormatString="0"
                                       HorizontalAlignment="Left" MinWidth="120" />
                    </Grid>
                    <StackPanel Margin="16,4,0,0" Spacing="2">
                        <CheckBox Content="{l:Loc Pref_AssistantProseSummary}"
                                  AutomationProperties.AutomationId="Preferences.AssistantProseSummary"
                                  IsChecked="{Binding AssistantRequireProseSummary}" />
                        <CheckBox Content="{l:Loc Pref_AssistantSynthesize}"
                                  AutomationProperties.AutomationId="Preferences.AssistantSynthesize"
                                  IsChecked="{Binding AssistantSynthesizeFinalAnswer}" />
                        <CheckBox Content="{l:Loc Pref_AssistantStreaming}"
                                  AutomationProperties.AutomationId="Preferences.AssistantStreaming"
                                  IsChecked="{Binding AssistantStreaming}" />
                        <CheckBox Content="{l:Loc Pref_AssistantSuggestCodeBlocks}"
                                  AutomationProperties.AutomationId="Preferences.AssistantSuggestCodeBlocks"
                                  IsChecked="{Binding AssistantSuggestCodeBlocks}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Margin="16,6,0,0">
                        <TextBlock Grid.Column="0" Text="{l:Loc Pref_AssistantContextMode}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" MinWidth="200" HorizontalAlignment="Left"
                                  AutomationProperties.AutomationId="Preferences.AssistantContextMode" AutomationProperties.Name="{l:Loc Pref_AssistantContextMode}"
                                  SelectedIndex="{Binding AssistantContextModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{l:Loc Pref_ContextModeNone}" />
                            <ComboBoxItem Content="{l:Loc Pref_ContextModeCard}" />
                            <ComboBoxItem Content="{l:Loc Pref_ContextModePack}" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{l:Loc Pref_AssistantContextModeHelp}" Margin="16,2,0,0"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />

                    <Separator Margin="0,6" />
                    <TextBlock Text="{l:Loc Pref_CliHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Debug: low-level embedded-web-view workarounds (restart to apply). -->
                <StackPanel AutomationProperties.AutomationId="Preferences.Section.Debug" Spacing="10" IsVisible="{Binding IsDebug}">
                    <TextBlock Text="{l:Loc Pref_Debug}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{l:Loc Pref_DebugHelp}"
                               Foreground="Gray" TextWrapping="Wrap" />

                    <TextBlock Text="{l:Loc Pref_DebugWebViewLinux}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <CheckBox Content="{l:Loc Pref_DbgDisableDmabuf}"
                              AutomationProperties.AutomationId="Preferences.WebViewDisableDmabuf"
                              IsChecked="{Binding WebViewDisableDmabufRenderer}" />
                    <TextBlock Text="{l:Loc Pref_DbgDisableDmabufHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />
                    <CheckBox Content="{l:Loc Pref_DbgDisableCompositing}"
                              AutomationProperties.AutomationId="Preferences.WebViewDisableCompositing"
                              IsChecked="{Binding WebViewDisableCompositing}" />
                    <TextBlock Text="{l:Loc Pref_DbgDisableCompositingHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />
                    <CheckBox Content="{l:Loc Pref_DbgOffscreen}"
                              AutomationProperties.AutomationId="Preferences.WebViewOffscreen"
                              IsChecked="{Binding WebViewExperimentalOffscreen}" />
                    <TextBlock Text="{l:Loc Pref_DbgOffscreenHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />

                    <Separator Margin="0,6" />
                    <CheckBox Content="{l:Loc Pref_DbgDevTools}"
                              AutomationProperties.AutomationId="Preferences.WebViewDevTools"
                              IsChecked="{Binding WebViewEnableDevTools}" />
                    <TextBlock Text="{l:Loc Pref_DbgDevToolsHelp}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" />
                </StackPanel>

                <!-- Keyboard Shortcuts -->
                <DockPanel AutomationProperties.AutomationId="Preferences.Section.Keyboard" IsVisible="{Binding IsKeyboard}" VerticalAlignment="Top">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Pref_Keyboard}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                        <Button AutomationProperties.AutomationId="Preferences.Keyboard.ResetAll" Content="{l:Loc Pref_ResetAll}" Command="{Binding Keyboard.ResetAllCommand}" />
                        <TextBlock VerticalAlignment="Center" Foreground="Gray" FontSize="11"
                                   Text="{l:Loc Pref_KbHelp}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Keyboard.Rows}"
                              AutomationProperties.AutomationId="Preferences.Keyboard.Grid" AutomationProperties.Name="{l:Loc Pref_Keyboard}"
                              x:CompileBindings="False" VerticalAlignment="Top"
                              GridLinesVisibility="Horizontal" Height="440"
                              CanUserResizeColumns="True" CanUserSortColumns="True" AutoGenerateColumns="False">
                        <!-- Columns fit the available width: Command takes the slack (*) so the last
                             column stays on-screen, and the Gesture capture box is a bounded width
                             (~a third of its former full-width size) instead of eating the whole row. -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Command}" Binding="{Binding CommandId}" Width="*" MinWidth="140" IsReadOnly="True" />
                            <!-- Capture box: focus it and press a chord to record the gesture (#11). -->
                            <DataGridTemplateColumn Header="{l:Loc Pref_Col_Gesture}" Width="180" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Gesture}" IsReadOnly="True"
                                                 Watermark="{l:Loc Pref_PressKeysWm}" Margin="2"
                                                 KeyDown="OnGestureKeyDown"
                                                 ToolTip.Tip="{l:Loc Pref_GestureTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Pref_Col_Default}" Binding="{Binding DefaultGesture}" Width="Auto" MinWidth="90" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{l:Loc Pref_Reset}" Command="{Binding ResetToDefaultCommand}" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- File Associations (Task 5): user-triggered, per-type register/remove. -->
                <DockPanel AutomationProperties.AutomationId="Preferences.Section.Associations" IsVisible="{Binding IsAssociations}" VerticalAlignment="Top">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Pref_Associations}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Assoc_Intro}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Associations.PlatformNote}"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                                IsEnabled="{Binding Associations.IsSupported}">
                        <Button AutomationProperties.AutomationId="Preferences.Associations.AssociateAll" Content="{l:Loc Assoc_AssociateAll}" Command="{Binding Associations.AssociateAllCommand}" />
                        <Button AutomationProperties.AutomationId="Preferences.Associations.RemoveAll" Content="{l:Loc Assoc_RemoveAll}" Command="{Binding Associations.UnassociateAllCommand}" />
                        <Button AutomationProperties.AutomationId="Preferences.Associations.Refresh" Content="{l:Loc Common_Refresh}" Command="{Binding Associations.RefreshCommand}" />
                        <TextBlock VerticalAlignment="Center" Foreground="Gray"
                                   Text="{Binding Associations.Status}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Associations.Rows}"
                              AutomationProperties.AutomationId="Preferences.Associations.Grid" AutomationProperties.Name="{l:Loc Pref_Associations}"
                              x:CompileBindings="False" Height="420" VerticalAlignment="Top"
                              IsEnabled="{Binding Associations.IsSupported}"
                              GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" AutoGenerateColumns="False">
                        <!-- Columns fit the available width: the Description is a bounded width (~60%
                             of its former full-width size) and Status takes the slack (*) so the last
                             column (the Associate/Remove buttons) stays on-screen. -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Loc Assoc_Col_Type}"   Binding="{Binding Extension}"   Width="Auto" MinWidth="90"  IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Assoc_Col_Desc}"   Binding="{Binding Description}" Width="220"  MinWidth="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Assoc_Col_Status}" Binding="{Binding StatusText}"  Width="*"    MinWidth="190" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="{l:Loc Assoc_Associate}" Command="{Binding AssociateCommand}"
                                                    IsEnabled="{Binding CanManage}" Margin="2" />
                                            <Button Content="{l:Loc Assoc_Remove}" Command="{Binding UnassociateCommand}"
                                                    IsVisible="{Binding IsAssociated}" Margin="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</Window>
