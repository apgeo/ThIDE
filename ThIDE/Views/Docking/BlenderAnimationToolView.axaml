<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThIDE.ViewModels.Docking"
             xmlns:vmm="using:ThIDE.ViewModels"
             xmlns:l="using:ThIDE.Resources"
             xmlns:local="using:ThIDE.Views.Docking"
             x:Class="ThIDE.Views.Docking.BlenderAnimationToolView"
             AutomationProperties.AutomationId="Blender.View"
             x:DataType="vm:BlenderAnimationToolViewModel">

    <!-- Blender Animation panel (BA-B12). Binds to the tool VM; the content VM is reached via
         the `Blender.` prefix (compiled bindings). -->
    <ScrollViewer AutomationProperties.AutomationId="Blender.Content">
        <StackPanel AutomationProperties.AutomationId="Blender.Panel" Margin="10" Spacing="8" MinWidth="320">

            <!-- experimental / WIP banner -->
            <Border Background="#33B08000" BorderBrush="#B08000" BorderThickness="1" CornerRadius="3" Padding="8,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#x26A0;" FontSize="14" Margin="0,0,6,0"
                               Foreground="#B08000" VerticalAlignment="Top" />
                    <TextBlock Text="{l:Loc Blender_UI_Experimental}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- preset strip -->
            <TextBlock Text="{l:Loc Blender_UI_Preset}" FontWeight="Bold" />
            <ComboBox HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="Blender.Preset" AutomationProperties.Name="{l:Loc Blender_UI_Preset}"
                      ItemsSource="{Binding Blender.Presets}"
                      SelectedItem="{Binding Blender.SelectedPreset}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmm:PresetItem">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <DockPanel>
                <Button AutomationProperties.AutomationId="Blender.DeletePreset" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_DeletePreset}" Command="{Binding Blender.DeletePresetCommand}" Margin="4,0,0,0" />
                <Button AutomationProperties.AutomationId="Blender.SavePreset" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_SavePreset}" Command="{Binding Blender.SavePresetCommand}" Margin="4,0,0,0" />
                <TextBox AutomationProperties.AutomationId="Blender.NewPresetName" AutomationProperties.Name="{l:Loc Blender_UI_NewPresetName}" Watermark="{l:Loc Blender_UI_NewPresetName}" Text="{Binding Blender.NewPresetName}" />
            </DockPanel>

            <Separator />

            <!-- source -->
            <TextBlock Text="{l:Loc Blender_UI_Source}" FontWeight="Bold" />
            <CheckBox AutomationProperties.AutomationId="Blender.UseExternalFile" Content="{l:Loc Blender_UI_UseExternalFile}" IsChecked="{Binding Blender.UseExternalFile}" />
            <TextBox Watermark="{l:Loc Blender_UI_ExternalFile}" Text="{Binding Blender.ExternalFilePath}"
                     AutomationProperties.AutomationId="Blender.ExternalFilePath" AutomationProperties.Name="{l:Loc Blender_UI_ExternalFile}"
                     IsVisible="{Binding Blender.UseExternalFile}" />
            <DockPanel IsVisible="{Binding !Blender.UseExternalFile}">
                <Button AutomationProperties.AutomationId="Blender.ReloadArtifacts" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_ReloadArtifacts}" Command="{Binding Blender.ReloadArtifactsCommand}" Margin="4,0,0,0" />
                <ComboBox HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="Blender.Artifact" AutomationProperties.Name="{l:Loc Blender_UI_Source}"
                          ItemsSource="{Binding Blender.Artifacts}"
                          SelectedItem="{Binding Blender.SelectedArtifact}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vmm:ArtifactItem">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <Separator />

            <!-- camera + engine -->
            <TextBlock Text="{l:Loc Blender_UI_Camera}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Template}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.CameraTemplate" AutomationProperties.Name="{l:Loc Blender_UI_Template}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.CameraTemplates}" SelectedItem="{Binding Blender.CameraTemplate}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Surface}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.Surface" AutomationProperties.Name="{l:Loc Blender_UI_Surface}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.SurfaceModes}" SelectedItem="{Binding Blender.SurfaceMode}" ToolTip.Tip="{l:Loc Blender_UI_Surface_Tip}" /></DockPanel>
            <DockPanel IsEnabled="{Binding Blender.HasSurface}"><TextBlock Text="{l:Loc Blender_UI_SurfaceOpacity}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Blender.SurfaceOpacity, StringFormat='{}{0:0%}'}" DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider AutomationProperties.AutomationId="Blender.SurfaceOpacity" AutomationProperties.Name="{l:Loc Blender_UI_SurfaceOpacity}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Blender.SurfaceOpacity}" ToolTip.Tip="{l:Loc Blender_UI_SurfaceOpacity_Tip}" /></DockPanel>

            <!-- light: a rig, or an image all round the scene (HDRI) -->
            <TextBlock Text="{l:Loc Blender_UI_Light}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_LightRig}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.LightRig" AutomationProperties.Name="{l:Loc Blender_UI_LightRig}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.LightRigs}" SelectedItem="{Binding Blender.LightRig}" ToolTip.Tip="{l:Loc Blender_UI_LightRig_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_LightStrength}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.LightStrength" AutomationProperties.Name="{l:Loc Blender_UI_LightStrength}" Text="{Binding Blender.LightStrength}" ToolTip.Tip="{l:Loc Blender_UI_LightStrength_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_HdriPath}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Button AutomationProperties.AutomationId="Blender.BrowseHdri" AutomationProperties.Name="{l:Loc Blender_UI_BrowseHdri}" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_Browse}" Command="{Binding Blender.BrowseHdriCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_BrowseHdri}" />
                <TextBox AutomationProperties.AutomationId="Blender.HdriPath" AutomationProperties.Name="{l:Loc Blender_UI_HdriPath}" Text="{Binding Blender.HdriPath}" IsEnabled="{Binding Blender.IsHdri}" ToolTip.Tip="{l:Loc Blender_UI_HdriPath_Tip}" /></DockPanel>
            <DockPanel IsEnabled="{Binding Blender.IsHdri}"><TextBlock Text="{l:Loc Blender_UI_HdriRotation}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox AutomationProperties.AutomationId="Blender.HdriRotation" AutomationProperties.Name="{l:Loc Blender_UI_HdriRotation}" Text="{Binding Blender.HdriRotation}" ToolTip.Tip="{l:Loc Blender_UI_HdriRotation_Tip}" /></DockPanel>

            <TextBlock Text="{l:Loc Blender_UI_Engine}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Engine}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.Engine" AutomationProperties.Name="{l:Loc Blender_UI_Engine}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.Engines}" SelectedItem="{Binding Blender.EngineKind}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Gpu}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.Gpu" AutomationProperties.Name="{l:Loc Blender_UI_Gpu}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.GpuModes}" SelectedItem="{Binding Blender.Gpu}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Samples}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Samples" AutomationProperties.Name="{l:Loc Blender_UI_Samples}" Text="{Binding Blender.Samples}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Builder}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox AutomationProperties.AutomationId="Blender.Builder" AutomationProperties.Name="{l:Loc Blender_UI_Builder}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.Builders}" SelectedItem="{Binding Blender.Builder}" ToolTip.Tip="{l:Loc Blender_UI_Builder_Tip}" /></DockPanel>

            <!-- animation -->
            <TextBlock Text="{l:Loc Blender_UI_Animation}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Fps}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Fps" AutomationProperties.Name="{l:Loc Blender_UI_Fps}" Text="{Binding Blender.Fps}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Duration}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Duration" AutomationProperties.Name="{l:Loc Blender_UI_Duration}" Text="{Binding Blender.DurationSeconds}" /></DockPanel>

            <!-- reveal: the cave appears part by part while the clip runs -->
            <TextBlock Text="{l:Loc Blender_UI_Reveal}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_RevealBy}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.Reveal" AutomationProperties.Name="{l:Loc Blender_UI_RevealBy}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.RevealChoices}" SelectedItem="{Binding Blender.RevealMode}" ToolTip.Tip="{l:Loc Blender_UI_RevealBy_Tip}" /></DockPanel>
            <StackPanel Spacing="8" IsVisible="{Binding Blender.HasReveal}">
                <DockPanel IsEnabled="{Binding Blender.RevealsByDistance}"><TextBlock Text="{l:Loc Blender_UI_RevealFrom}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <TextBox AutomationProperties.AutomationId="Blender.RevealFrom" AutomationProperties.Name="{l:Loc Blender_UI_RevealFrom}" Text="{Binding Blender.RevealFrom}" ToolTip.Tip="{l:Loc Blender_UI_RevealFrom_Tip}" /></DockPanel>
                <DockPanel IsEnabled="{Binding Blender.RevealsByDate}"><TextBlock Text="{l:Loc Blender_UI_RevealDates}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button AutomationProperties.AutomationId="Blender.BrowseRevealDates" AutomationProperties.Name="{l:Loc Blender_UI_BrowseRevealDates}" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_Browse}" Command="{Binding Blender.BrowseRevealDatesCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_BrowseRevealDates}" />
                    <TextBox AutomationProperties.AutomationId="Blender.RevealDates" AutomationProperties.Name="{l:Loc Blender_UI_RevealDates}" Text="{Binding Blender.RevealDatesPath}" ToolTip.Tip="{l:Loc Blender_UI_RevealDates_Tip}" /></DockPanel>
                <DockPanel><TextBlock Text="{l:Loc Blender_UI_RevealStart}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox AutomationProperties.AutomationId="Blender.RevealStart" AutomationProperties.Name="{l:Loc Blender_UI_RevealStart}" Text="{Binding Blender.RevealStart}" ToolTip.Tip="{l:Loc Blender_UI_RevealStart_Tip}" /></DockPanel>
                <CheckBox AutomationProperties.AutomationId="Blender.RevealToClipEnd" Content="{l:Loc Blender_UI_RevealToClipEnd}" IsChecked="{Binding Blender.RevealToClipEnd}" ToolTip.Tip="{l:Loc Blender_UI_RevealToClipEnd_Tip}" />
                <DockPanel IsEnabled="{Binding Blender.RevealHasItsOwnEnd}"><TextBlock Text="{l:Loc Blender_UI_RevealEnd}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox AutomationProperties.AutomationId="Blender.RevealEnd" AutomationProperties.Name="{l:Loc Blender_UI_RevealEnd}" Text="{Binding Blender.RevealEnd}" ToolTip.Tip="{l:Loc Blender_UI_RevealEnd_Tip}" /></DockPanel>
                <DockPanel><TextBlock Text="{l:Loc Blender_UI_RevealEdge}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <TextBox AutomationProperties.AutomationId="Blender.RevealEdge" AutomationProperties.Name="{l:Loc Blender_UI_RevealEdge}" Text="{Binding Blender.RevealEdge}" ToolTip.Tip="{l:Loc Blender_UI_RevealEdge_Tip}" /></DockPanel>
                <CheckBox AutomationProperties.AutomationId="Blender.RevealGlow" Content="{l:Loc Blender_UI_RevealGlow}" IsChecked="{Binding Blender.RevealGlow}" ToolTip.Tip="{l:Loc Blender_UI_RevealGlow_Tip}" />
            </StackPanel>

            <Separator />

            <!-- output -->
            <TextBlock Text="{l:Loc Blender_UI_Output}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Output}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.OutputKind" AutomationProperties.Name="{l:Loc Blender_UI_Output}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.OutputKinds}" SelectedItem="{Binding Blender.OutputKind}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Container}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.Container" AutomationProperties.Name="{l:Loc Blender_UI_Container}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.Containers}" SelectedItem="{Binding Blender.Container}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Width}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Width" AutomationProperties.Name="{l:Loc Blender_UI_Width}" Text="{Binding Blender.Width}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Height}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Height" AutomationProperties.Name="{l:Loc Blender_UI_Height}" Text="{Binding Blender.Height}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_BaseName}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.BaseName" AutomationProperties.Name="{l:Loc Blender_UI_BaseName}" Text="{Binding Blender.BaseName}" /></DockPanel>
            <CheckBox AutomationProperties.AutomationId="Blender.SelfContained" Content="{l:Loc Blender_UI_SelfContained}" IsChecked="{Binding Blender.SelfContained}" ToolTip.Tip="{l:Loc Blender_UI_SelfContained_Tip}" />
            <CheckBox AutomationProperties.AutomationId="Blender.EmbedMesh" Content="{l:Loc Blender_UI_EmbedMesh}" IsChecked="{Binding Blender.EmbedMesh}" IsEnabled="{Binding Blender.CanEmbedMesh}" Margin="20,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_EmbedMesh_Tip}" />

            <!-- labels -->
            <TextBlock Text="{l:Loc Blender_UI_Labels}" FontWeight="Bold" />
            <CheckBox AutomationProperties.AutomationId="Blender.StationLabels" Content="{l:Loc Blender_UI_StationLabels}" IsChecked="{Binding Blender.ShowStationLabels}" />
            <CheckBox AutomationProperties.AutomationId="Blender.LeadMarkers" Content="{l:Loc Blender_UI_LeadMarkers}" IsChecked="{Binding Blender.ShowLeadMarkers}" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_LeadMarkerSize}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.LeadMarkerSize" AutomationProperties.Name="{l:Loc Blender_UI_LeadMarkerSize}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.LeadMarkerSizings}" SelectedItem="{Binding Blender.LeadMarkerSizing}" ToolTip.Tip="{l:Loc Blender_UI_LeadMarkerSize_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_LabelRoof}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <ComboBox AutomationProperties.AutomationId="Blender.LabelRoof" AutomationProperties.Name="{l:Loc Blender_UI_LabelRoof}" HorizontalAlignment="Stretch" ItemsSource="{Binding Blender.LabelRoofSources}" SelectedItem="{Binding Blender.LabelRoof}" ToolTip.Tip="{l:Loc Blender_UI_LabelRoof_Tip}" /></DockPanel>

            <!-- annotations: labels, callouts, markers and photos, from a JSON file -->
            <TextBlock Text="{l:Loc Blender_UI_Annotations}" FontWeight="Bold" ToolTip.Tip="{l:Loc Blender_UI_Annotations_Tip}" />
            <DockPanel>
                <Button AutomationProperties.AutomationId="Blender.ClearAnnotations" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_ClearAnnotations}" Command="{Binding Blender.ClearAnnotationsCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_ClearAnnotations_Tip}" />
                <Button AutomationProperties.AutomationId="Blender.LoadAnnotations" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_LoadAnnotations}" Command="{Binding Blender.LoadAnnotationsCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_LoadAnnotations_Tip}" />
                <Button AutomationProperties.AutomationId="Blender.BrowseAnnotations" AutomationProperties.Name="{l:Loc Blender_UI_BrowseAnnotations}" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_Browse}" Command="{Binding Blender.BrowseAnnotationsCommand}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_BrowseAnnotations}" />
                <TextBox AutomationProperties.AutomationId="Blender.AnnotationsPath" AutomationProperties.Name="{l:Loc Blender_UI_AnnotationsPath}" Watermark="{l:Loc Blender_UI_AnnotationsPath}" Text="{Binding Blender.AnnotationsPath}" ToolTip.Tip="{l:Loc Blender_UI_Annotations_Tip}" />
            </DockPanel>
            <TextBlock AutomationProperties.AutomationId="Blender.AnnotationsSummary" Text="{Binding Blender.AnnotationsSummary}" TextWrapping="Wrap" />
            <ItemsControl AutomationProperties.AutomationId="Blender.AnnotationProblems" AutomationProperties.Name="{l:Loc Blender_UI_AnnotationProblems}" ItemsSource="{Binding Blender.AnnotationProblems}" Foreground="#C05050">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- texts over the picture -->
            <TextBlock Text="{l:Loc Blender_UI_Texts}" FontWeight="Bold" />
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Title}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Title" AutomationProperties.Name="{l:Loc Blender_UI_Title}" Text="{Binding Blender.Title}" ToolTip.Tip="{l:Loc Blender_UI_Title_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Subtitle}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Subtitle" AutomationProperties.Name="{l:Loc Blender_UI_Subtitle}" Text="{Binding Blender.Subtitle}" ToolTip.Tip="{l:Loc Blender_UI_Subtitle_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_Credits}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.Credits" AutomationProperties.Name="{l:Loc Blender_UI_Credits}" Text="{Binding Blender.Credits}" ToolTip.Tip="{l:Loc Blender_UI_Credits_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_EndCard}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.EndCard" AutomationProperties.Name="{l:Loc Blender_UI_EndCard}" Text="{Binding Blender.EndCardText}" AcceptsReturn="True" TextWrapping="Wrap" ToolTip.Tip="{l:Loc Blender_UI_EndCard_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_EndCardSeconds}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox AutomationProperties.AutomationId="Blender.EndCardSeconds" AutomationProperties.Name="{l:Loc Blender_UI_EndCardSeconds}" Text="{Binding Blender.EndCardSeconds}" /></DockPanel>
            <WrapPanel>
                <CheckBox AutomationProperties.AutomationId="Blender.ScaleBar" Content="{l:Loc Blender_UI_ScaleBar}" IsChecked="{Binding Blender.ShowScaleBar}" Margin="0,0,12,0" ToolTip.Tip="{l:Loc Blender_UI_ScaleBar_Tip}" />
                <CheckBox AutomationProperties.AutomationId="Blender.NorthArrow" Content="{l:Loc Blender_UI_NorthArrow}" IsChecked="{Binding Blender.ShowNorthArrow}" Margin="0,0,12,0" ToolTip.Tip="{l:Loc Blender_UI_NorthArrow_Tip}" />
                <CheckBox AutomationProperties.AutomationId="Blender.DepthLegend" Content="{l:Loc Blender_UI_DepthLegend}" IsChecked="{Binding Blender.ShowDepthLegend}" ToolTip.Tip="{l:Loc Blender_UI_DepthLegend_Tip}" />
            </WrapPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_FadeFromBlack}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox AutomationProperties.AutomationId="Blender.FadeFromBlack" AutomationProperties.Name="{l:Loc Blender_UI_FadeFromBlack}" Text="{Binding Blender.FadeFromBlack}" ToolTip.Tip="{l:Loc Blender_UI_Fade_Tip}" /></DockPanel>
            <DockPanel><TextBlock Text="{l:Loc Blender_UI_FadeToBlack}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox AutomationProperties.AutomationId="Blender.FadeToBlack" AutomationProperties.Name="{l:Loc Blender_UI_FadeToBlack}" Text="{Binding Blender.FadeToBlack}" ToolTip.Tip="{l:Loc Blender_UI_Fade_Tip}" /></DockPanel>

            <!-- captions: a text, and the seconds it is shown from and to -->
            <DockPanel>
                <Button AutomationProperties.AutomationId="Blender.AddCaption" DockPanel.Dock="Right" Content="{l:Loc Blender_UI_AddCaption}" Command="{Binding Blender.AddCaptionCommand}" ToolTip.Tip="{l:Loc Blender_UI_AddCaption_Tip}" />
                <TextBlock Text="{l:Loc Blender_UI_Captions}" VerticalAlignment="Center" ToolTip.Tip="{l:Loc Blender_UI_Captions_Tip}" />
            </DockPanel>
            <Grid ColumnDefinitions="22,*,96,96,30" IsVisible="{Binding Blender.HasCaptions}">
                <TextBlock Grid.Column="1" Text="{l:Loc Blender_UI_CaptionText}" FontSize="11" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="{l:Loc Blender_UI_CaptionStart}" FontSize="11" Opacity="0.7" Margin="4,0,0,0" />
                <TextBlock Grid.Column="3" Text="{l:Loc Blender_UI_CaptionEnd}" FontSize="11" Opacity="0.7" Margin="4,0,0,0" />
            </Grid>
            <ItemsControl AutomationProperties.AutomationId="Blender.Captions" AutomationProperties.Name="{l:Loc Blender_UI_Captions}" ItemsSource="{Binding Blender.Captions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmm:CaptionRowViewModel">
                        <Grid ColumnDefinitions="22,*,96,96,30" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBox Grid.Column="1" AutomationProperties.AutomationId="{Binding TextId}" AutomationProperties.Name="{l:Loc Blender_UI_CaptionText}"
                                     Watermark="{l:Loc Blender_UI_CaptionText}" Text="{Binding Text}" />
                            <TextBox Grid.Column="2" AutomationProperties.AutomationId="{Binding StartId}" AutomationProperties.Name="{l:Loc Blender_UI_CaptionStart}"
                                     Text="{Binding Start}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_CaptionStart_Tip}" />
                            <TextBox Grid.Column="3" AutomationProperties.AutomationId="{Binding EndId}" AutomationProperties.Name="{l:Loc Blender_UI_CaptionEnd}"
                                     Text="{Binding End}" Margin="4,0,0,0" ToolTip.Tip="{l:Loc Blender_UI_CaptionEnd_Tip}" />
                            <Button Grid.Column="4" AutomationProperties.AutomationId="{Binding RemoveId}" AutomationProperties.Name="{l:Loc Blender_UI_RemoveCaption}"
                                    Content="&#x2715;" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip.Tip="{l:Loc Blender_UI_RemoveCaption}"
                                    Command="{Binding $parent[ItemsControl].((vm:BlenderAnimationToolViewModel)DataContext).Blender.RemoveCaptionCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- the captions along the clip: each where its seconds fall -->
            <StackPanel IsVisible="{Binding Blender.HasCaptions}" Spacing="2">
                <Border AutomationProperties.AutomationId="Blender.CaptionStrip" AutomationProperties.Name="{l:Loc Blender_UI_CaptionStrip}"
                        Height="20" BorderBrush="#80808080" BorderThickness="1" CornerRadius="2" ClipToBounds="True"
                        ToolTip.Tip="{l:Loc Blender_UI_CaptionStrip_Tip}">
                    <Grid>
                        <!-- the clip itself, where a caption runs past its end -->
                        <local:CaptionStripPanel>
                            <Border Background="#22808080" local:CaptionStripPanel.Start="0" local:CaptionStripPanel.End="{Binding Blender.ClipEndOnStrip}" />
                        </local:CaptionStripPanel>
                        <ItemsControl ItemsSource="{Binding Blender.Captions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><local:CaptionStripPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter" x:DataType="vmm:CaptionRowViewModel">
                                    <Setter Property="local:CaptionStripPanel.Start" Value="{Binding StripStart}" />
                                    <Setter Property="local:CaptionStripPanel.End" Value="{Binding StripEnd}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vmm:CaptionRowViewModel">
                                    <Border Background="#B04A90D9" BorderBrush="#FF2F6DB0" BorderThickness="1,0" Margin="0,2"
                                            IsVisible="{Binding IsShown}" ToolTip.Tip="{Binding Text}">
                                        <TextBlock Text="{Binding Number}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Text="{Binding Blender.CaptionStripSeconds, StringFormat='{}{0:0.##} s'}" />
                    <TextBlock FontSize="11" Opacity="0.7" Text="0 s" />
                </DockPanel>
            </StackPanel>

            <Separator />

            <!-- validation blockers -->
            <TextBlock Text="{l:Loc Blender_UI_Blockers}" FontWeight="Bold"
                       IsVisible="{Binding Blender.Blockers.Count}" />
            <ItemsControl AutomationProperties.AutomationId="Blender.Blockers" ItemsSource="{Binding Blender.Blockers}" Foreground="#C05050" />

            <!-- actions -->
            <DockPanel>
                <TextBlock Text="{l:Loc Blender_UI_Frames}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Blender.EstimatedFrameCount}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="{l:Loc Blender_UI_RenderDir}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.RenderDirectory" AutomationProperties.Name="{l:Loc Blender_UI_RenderDir}" Text="{Binding Blender.RenderDirectory}"
                         ToolTip.Tip="{l:Loc Blender_UI_RenderDirTip}" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="{l:Loc Blender_UI_ExportDir}" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <TextBox AutomationProperties.AutomationId="Blender.ExportDirectory" AutomationProperties.Name="{l:Loc Blender_UI_ExportDir}" Text="{Binding Blender.ExportDirectory}" />
            </DockPanel>
            <WrapPanel>
                <Button AutomationProperties.AutomationId="Blender.Render" Content="{l:Loc Blender_UI_Render}" Command="{Binding Blender.RenderCommand}" Margin="0,0,6,6" />
                <Button AutomationProperties.AutomationId="Blender.Preview" Content="{l:Loc Blender_UI_Preview}" Command="{Binding Blender.PreviewCommand}" ToolTip.Tip="{l:Loc Blender_UI_Preview_Tip}" Margin="0,0,6,6" />
                <Button AutomationProperties.AutomationId="Blender.ExportScript" Content="{l:Loc Blender_UI_Export}" Command="{Binding Blender.ExportScriptCommand}" ToolTip.Tip="{l:Loc Blender_UI_Export_Tip}" Margin="0,0,6,6" />
                <Button AutomationProperties.AutomationId="Blender.OpenInBlender" Content="{l:Loc Blender_UI_OpenInBlender}" Command="{Binding Blender.OpenInBlenderGuiCommand}" ToolTip.Tip="{l:Loc Blender_UI_OpenInBlender_Tip}" Margin="0,0,6,6" />
                <Button AutomationProperties.AutomationId="Blender.Cancel" Content="{l:Loc Blender_UI_Cancel}" Command="{Binding Blender.CancelCommand}" IsVisible="{Binding Blender.IsBusy}" Margin="0,0,6,6" />
            </WrapPanel>

            <!-- status + progress -->
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Blender.ProgressFraction}"
                         IsIndeterminate="{Binding Blender.IsIndeterminate}" IsVisible="{Binding Blender.IsBusy}" />
            <TextBlock Text="{Binding Blender.StatusMessage}" />
            <TextBlock Text="{Binding Blender.Device}" IsVisible="{Binding Blender.Device, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Blender.LastError}" Foreground="#C05050" TextWrapping="Wrap"
                       IsVisible="{Binding Blender.LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- not-found affordance: point the user at Preferences -->
            <TextBlock Text="{l:Loc Blender_Fail_NotFound}" Foreground="#C05050" TextWrapping="Wrap"
                       FontStyle="Italic" IsVisible="{Binding Blender.BlenderMissing}" />

            <!-- outputs -->
            <TextBlock Text="{l:Loc Blender_UI_Outputs}" FontWeight="Bold" IsVisible="{Binding Blender.Outputs.Count}" />
            <ItemsControl AutomationProperties.AutomationId="Blender.Outputs" ItemsSource="{Binding Blender.Outputs}" />
            <WrapPanel IsVisible="{Binding Blender.Outputs.Count}">
                <Button AutomationProperties.AutomationId="Blender.OpenOutputFolder" Content="{l:Loc Blender_UI_OpenFolder}" Command="{Binding Blender.OpenOutputFolderCommand}" Margin="0,4,6,0" />
                <Button AutomationProperties.AutomationId="Blender.OpenJobLog" Content="{l:Loc Blender_UI_OpenLog}" Command="{Binding Blender.OpenJobLogCommand}" Margin="0,4,6,0" />
            </WrapPanel>
            <ItemsControl AutomationProperties.AutomationId="Blender.Warnings" ItemsSource="{Binding Blender.Warnings}" Foreground="#B08000">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- recent renders -->
            <TextBlock Text="{l:Loc Blender_UI_Jobs}" FontWeight="Bold" IsVisible="{Binding Blender.Jobs.Count}" Margin="0,8,0,0" />
            <ItemsControl AutomationProperties.AutomationId="Blender.Jobs" ItemsSource="{Binding Blender.Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmm:JobHistoryEntry">
                        <DockPanel Margin="0,2,0,2">
                            <Button DockPanel.Dock="Left" Content="&#x29C9;" Padding="4,0" FontSize="12"
                                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                    ToolTip.Tip="{l:Loc Blender_UI_CopyResult}"
                                    Command="{Binding $parent[ItemsControl].DataContext.Blender.CopyJobCommand}"
                                    CommandParameter="{Binding}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" Width="150"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
