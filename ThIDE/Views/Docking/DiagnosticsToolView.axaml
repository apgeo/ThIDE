<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThIDE.ViewModels.Docking"
             xmlns:l="using:ThIDE.Resources"
             x:Class="ThIDE.Views.Docking.DiagnosticsToolView"
             AutomationProperties.AutomationId="Diagnostics.View"
             ClipToBounds="True"
             x:DataType="vm:DiagnosticsToolViewModel">
    <!-- Rows: toolbar, filters, the grid, the explanation pane. The bottom dock keeps the panel tall
         enough for three full rows (DockFactory), the explanation pane is one line until it is
         expanded, and the grid never gives up its header and first row to it, so selecting a row at
         laptop height no longer squeezes the list away. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="64" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- explanation pane for the selected diagnostic (thbook link + example fix). The one-line
             strip is always there, empty until a row with an explanation is selected: if it appeared
             on the first click, the rows would move and the second click of a double-click would
             land on it instead of the row. -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="8,3" MinHeight="25"
                AutomationProperties.AutomationId="Diagnostics.Details"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Spacing="4" IsVisible="{Binding Diagnostics.HasExplanation}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Diagnostics.Selected.Code}" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <!-- Collapsed: the explanation on one line, in full on hover. -->
                    <TextBlock Grid.Column="1" Text="{Binding Diagnostics.SelectedExplanation}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"
                               ToolTip.Tip="{Binding Diagnostics.SelectedExplanation}"
                               IsVisible="{Binding !#DetailsToggle.IsChecked}" />
                    <Button Grid.Column="2" FontSize="11" Padding="6,1" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="Diagnostics.OpenDocs"
                            Command="{Binding Diagnostics.OpenDocsCommand}"
                            IsVisible="{Binding Diagnostics.HasDocLink}"
                            Content="{l:Loc Diag_OpenDocs}" />
                    <ToggleButton Grid.Column="3" x:Name="DetailsToggle" FontSize="11" Padding="6,1" Margin="6,0,0,0"
                                  AutomationProperties.AutomationId="Diagnostics.DetailsExpand"
                                  Content="{l:Loc Diag_Details}" ToolTip.Tip="{l:Loc Diag_DetailsTip}" />
                </Grid>
                <!-- Expanded: the whole explanation and the example, scrolling past a few lines. -->
                <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Auto"
                              IsVisible="{Binding #DetailsToggle.IsChecked}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Diagnostics.SelectedExplanation}" TextWrapping="Wrap" FontSize="12" />
                        <Border Background="#22808080" CornerRadius="3" Padding="6,3"
                                IsVisible="{Binding Diagnostics.HasExample}">
                            <TextBlock Text="{Binding Diagnostics.SelectedExample}" FontFamily="Consolas,monospace"
                                       FontSize="11" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2" Spacing="6">
            <ToggleButton Content="{l:Loc Diag_ProjectScope}"
                          AutomationProperties.AutomationId="Diagnostics.ProjectScope"
                          IsChecked="{Binding Diagnostics.ShowProjectScope, Mode=TwoWay}"
                          ToolTip.Tip="{l:Loc Diag_ProjectScopeTip}"
                          Padding="6,2" FontSize="11" />
            <!-- Roll-up of warnings/errors and the number of affected files (#3). -->
            <TextBlock Text="{Binding Diagnostics.SummaryText}" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="11" />
            <!-- Column show/hide + fit, mirroring the Generated Files grid (#3). -->
            <Button AutomationProperties.AutomationId="Diagnostics.Columns" Content="{l:Loc Common_Columns}" Padding="6,2" FontSize="11" ToolTip.Tip="Show or hide columns">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="2" Margin="8">
                            <CheckBox AutomationProperties.AutomationId="Diagnostics.Columns.Code" Content="{l:Loc Diag_Col_Code}"      Tag="Code"      IsChecked="True"  Click="OnToggleColumn" />
                            <CheckBox AutomationProperties.AutomationId="Diagnostics.Columns.Severity" Content="{l:Loc Diag_Col_Severity}"  Tag="Severity"  IsChecked="True"  Click="OnToggleColumn" />
                            <CheckBox AutomationProperties.AutomationId="Diagnostics.Columns.Message" Content="{l:Loc Diag_Col_Message}"   Tag="Message"   IsChecked="True"  Click="OnToggleColumn" />
                            <CheckBox AutomationProperties.AutomationId="Diagnostics.Columns.File" Content="{l:Loc Common_File}"      Tag="File"      IsChecked="True"  Click="OnToggleColumn" />
                            <CheckBox AutomationProperties.AutomationId="Diagnostics.Columns.Path" Content="{l:Loc Col_Path}"      Tag="Path"      IsChecked="False" Click="OnToggleColumn" />
                            <CheckBox AutomationProperties.AutomationId="Diagnostics.Columns.Line" Content="{l:Loc Browser_Col_Line}"      Tag="Line"      IsChecked="True"  Click="OnToggleColumn" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="{l:Loc Common_Fit}" Padding="6,2" FontSize="11" Click="OnFitColumns"
                    AutomationProperties.AutomationId="Diagnostics.FitColumns"
                    ToolTip.Tip="{l:Loc Common_FitAll}" />
        </StackPanel>

        <!-- search + severity/category filters + suppression. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,3" Spacing="6">
            <TextBox Width="180" Watermark="{l:Loc Common_Filter}" FontSize="11" Padding="4,1"
                     AutomationProperties.AutomationId="Diagnostics.Filter" AutomationProperties.Name="{l:Loc Common_Filter}"
                     Text="{Binding Diagnostics.SearchText, Mode=TwoWay}" />
            <ToggleButton AutomationProperties.AutomationId="Diagnostics.ShowErrors" Content="{l:Loc Diag_Errors}"   IsChecked="{Binding Diagnostics.ShowErrors, Mode=TwoWay}"   Padding="6,2" FontSize="11" />
            <ToggleButton AutomationProperties.AutomationId="Diagnostics.ShowWarnings" Content="{l:Loc Diag_Warnings}" IsChecked="{Binding Diagnostics.ShowWarnings, Mode=TwoWay}" Padding="6,2" FontSize="11" />
            <ToggleButton AutomationProperties.AutomationId="Diagnostics.ShowInfo" Content="{l:Loc Diag_Info}"     IsChecked="{Binding Diagnostics.ShowInfos, Mode=TwoWay}"    Padding="6,2" FontSize="11" />
            <ToggleButton Content="{l:Loc Diag_ReferencesOnly}" IsChecked="{Binding Diagnostics.OnlyReferences, Mode=TwoWay}"
                          AutomationProperties.AutomationId="Diagnostics.ReferencesOnly"
                          ToolTip.Tip="{l:Loc Diag_ReferencesTip}"
                          Padding="6,2" FontSize="11" />
            <Button Content="{l:Loc Diag_ClearSuppressions}" Padding="6,2" FontSize="11"
                    AutomationProperties.AutomationId="Diagnostics.ClearSuppressions"
                    Command="{Binding Diagnostics.ClearSuppressionsCommand}"
                    IsVisible="{Binding Diagnostics.HasSuppressions}" />
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="2"
                  AutomationProperties.AutomationId="Diagnostics.Grid" AutomationProperties.Name="{l:Loc Tool_Diagnostics}"
                  ItemsSource="{Binding Diagnostics.Rows}"
                  SelectedItem="{Binding Diagnostics.Selected, Mode=TwoWay}"
                  x:CompileBindings="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True" CanUserSortColumns="True" AutoGenerateColumns="False"
                  DoubleTapped="OnRowDoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem AutomationProperties.AutomationId="Diagnostics.Grid.Copy" Header="{l:Loc Common_Copy}" Click="OnCopyRow" />
                    <MenuItem AutomationProperties.AutomationId="Diagnostics.Grid.CopyAll" Header="{l:Loc Common_CopyAll}" Click="OnCopyAll" />
                    <Separator />
                    <MenuItem Header="{l:Loc Diag_Explain}" Command="{Binding Diagnostics.OpenDocsCommand}"
                              AutomationProperties.AutomationId="Diagnostics.Grid.Explain"
                              IsVisible="{Binding Diagnostics.HasDocLink}" />
                    <MenuItem AutomationProperties.AutomationId="Diagnostics.Grid.Suppress" Header="{l:Loc Diag_Suppress}" Command="{Binding Diagnostics.SuppressSelectedCodeCommand}" />
                    <Separator />
                    <MenuItem AutomationProperties.AutomationId="Diagnostics.Grid.Fix" Header="{l:Loc Diag_Fix}" Command="{Binding Diagnostics.FixSelectedCommand}" />
                    <MenuItem AutomationProperties.AutomationId="Diagnostics.Grid.FixAll" Header="{Binding Diagnostics.FixAllHeader}"
                              Command="{Binding Diagnostics.FixAllSelectedCodeCommand}" IsVisible="{Binding Diagnostics.CanFixAllSelected}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <!-- Columns auto-size to fit their header + content; Message takes the remaining
                 space and the long File path is capped with a hover tooltip (#5). -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Loc Diag_Col_Code}"     Binding="{Binding Code}"     Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="{l:Loc Diag_Col_Severity}" Binding="{Binding Severity}" Width="Auto" MinWidth="70" />
                <DataGridTemplateColumn Header="{l:Loc Diag_Col_Message}" Width="*" MinWidth="160" SortMemberPath="Message">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Padding="4,0"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- File name only (shown by default, #3). -->
                <DataGridTemplateColumn Header="{l:Loc Common_File}" Width="Auto" SortMemberPath="FileName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Padding="4,0"
                                       ToolTip.Tip="{Binding File}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Full path (hidden by default; shown in full, not trimmed, #3). -->
                <DataGridTextColumn Header="{l:Loc Col_Path}" Binding="{Binding File}" Width="Auto" />
                <DataGridTextColumn Header="{l:Loc Browser_Col_Line}"     Binding="{Binding Line}"     Width="Auto" MinWidth="48" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
