<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThIDE.ViewModels.Docking"
             xmlns:vm2="using:ThIDE.ViewModels"
             xmlns:docking="using:ThIDE.Views.Docking"
             xmlns:v="using:ThIDE.Views"
             xmlns:conv="using:ThIDE.Converters"
             xmlns:l="using:ThIDE.Resources"
             x:Class="ThIDE.Views.Docking.StructuralGeologyToolView"
             AutomationProperties.AutomationId="Structural.View"
             x:DataType="vm:StructuralGeologyToolViewModel">

    <!-- plane strike/dip calculator. Tabbed wizard: Detect → Measurements → Planes → Plot.
         Bindings are relative to the tool VM; the content VM is reached via the `Structural.` prefix. -->
    <UserControl.Resources>
        <!-- Cosmetic: show enum options (grouping / splay policy / declination source) as spaced text. -->
        <conv:EnumLabelConverter x:Key="EnumLabel" />
        <!-- Localized Wulff/Schmidt names for the stereonet projection combo. -->
        <conv:StereonetProjectionLabelConverter x:Key="NetProjLabel" />
        <!-- #10: measurements grouped by station; each group header carries a master checkbox that
             checks/unchecks the whole station. The header DataContext is the collection-view group;
             its Key is the StructuralPlaneRow (we group by the PlaneRow property). -->
        <ControlTheme x:Key="StationGroupHeaderTheme" TargetType="DataGridRowGroupHeader">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Padding="6,3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{ReflectionBinding Key.IncludeAllChecked, Mode=TwoWay}"
                                      ToolTip.Tip="{l:Loc Struct_CheckAllStation}" />
                            <TextBlock Text="{ReflectionBinding Key.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{ReflectionBinding ItemCount, StringFormat='({0})'}" Foreground="Gray" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top bar: scope + refresh + status (left), wizard prev/next (right). Shared across tabs. -->
        <Border AutomationProperties.AutomationId="Structural.Toolbar" DockPanel.Dock="Top" Padding="8,5" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <DockPanel>
                <!-- Shared panel window controls at the far right, stacked vertically to minimize
                     the horizontal space they take from the top bar. -->
                <docking:PanelWindowControls DockPanel.Dock="Right" Orientation="Vertical"
                                             AutomationProperties.AutomationId="Structural.WindowControls"
                                             VerticalAlignment="Center" Margin="4,0,0,0" />
                <!-- #6: hide (not disable) the nav buttons on the first/last tab, keeping their space. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Panel Width="64">
                        <Button Content="{l:Loc Struct_Prev}" Command="{Binding Structural.GoPrevCommand}" Padding="8,2" FontSize="11"
                                AutomationProperties.AutomationId="Structural.Prev"
                                IsVisible="{Binding Structural.CanGoPrev}" ToolTip.Tip="{l:Loc Struct_PrevTip}" />
                    </Panel>
                    <Panel Width="64">
                        <Button Content="{l:Loc Struct_Next}" Command="{Binding Structural.GoNextCommand}" Padding="8,2" FontSize="11"
                                AutomationProperties.AutomationId="Structural.Next"
                                IsVisible="{Binding Structural.CanGoNext}" ToolTip.Tip="{l:Loc Struct_NextTip}" />
                    </Panel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{l:Loc Struct_Scope}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" />
                    <RadioButton Content="{l:Loc Struct_ActiveFile}" GroupName="scope" FontSize="11"
                                 AutomationProperties.AutomationId="Structural.ScopeActiveFile"
                                 IsChecked="{Binding !Structural.ProjectScope}" />
                    <RadioButton Content="{l:Loc Struct_WholeProject}" GroupName="scope" FontSize="11"
                                 AutomationProperties.AutomationId="Structural.ScopeWholeProject"
                                 IsChecked="{Binding Structural.ProjectScope}" />
                    <Button AutomationProperties.AutomationId="Structural.Detect" Content="{l:Loc Struct_Detect}" Command="{Binding Structural.RefreshCommand}" Padding="8,2" FontSize="11" />
                    <TextBlock Text="{Binding Structural.Status}" VerticalAlignment="Center"
                               FontSize="11" Foreground="Gray" TextWrapping="NoWrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Name="Wizard" SelectedIndex="{Binding Structural.SelectedTab}" Padding="6"
                    AutomationProperties.AutomationId="Structural.Wizard"
                    SelectionChanged="OnTabChanged">

            <!-- 1 · Detect -->
            <TabItem AutomationProperties.AutomationId="Structural.Tab.Detection" Header="{l:Loc Struct_Tab1}">
                <ScrollViewer>
                    <StackPanel Margin="6" Spacing="10" MaxWidth="560" HorizontalAlignment="Left">

                        <TextBlock Text="{l:Loc Struct_DetectionSignals}" FontWeight="SemiBold" />
                        <TextBlock Text="{l:Loc Struct_DetectionHelp}"
                                   Foreground="Gray" TextWrapping="Wrap" FontSize="11" />

                        <CheckBox AutomationProperties.AutomationId="Structural.UseNameKeyword" Content="{l:Loc Struct_FromNameKeyword}" IsChecked="{Binding Structural.UseNameKeyword}" />
                        <TextBox Text="{Binding Structural.NameKeywords}" Watermark="geo" Margin="22,0,0,0"
                                 AutomationProperties.AutomationId="Structural.NameKeywords" AutomationProperties.Name="{l:Loc Struct_FromNameKeyword}"
                                 IsEnabled="{Binding Structural.UseNameKeyword}" />

                        <CheckBox AutomationProperties.AutomationId="Structural.MatchComment" Content="{l:Loc Struct_CommentMarker}" IsChecked="{Binding Structural.MatchComment}" />
                        <TextBox Text="{Binding Structural.CommentMarkers}" Watermark="plane, geo" Margin="22,0,0,0"
                                 AutomationProperties.AutomationId="Structural.CommentMarkers" AutomationProperties.Name="{l:Loc Struct_CommentMarker}"
                                 IsEnabled="{Binding Structural.MatchComment}" />

                        <CheckBox AutomationProperties.AutomationId="Structural.MatchStationFlag" Content="{l:Loc Struct_StationFlag}" IsChecked="{Binding Structural.MatchStationFlag}" />
                        <TextBox Text="{Binding Structural.StationFlags}" Watermark="e.g. geo" Margin="22,0,0,0"
                                 AutomationProperties.AutomationId="Structural.StationFlags" AutomationProperties.Name="{l:Loc Struct_StationFlag}"
                                 IsEnabled="{Binding Structural.MatchStationFlag}" />

                        <TextBlock Text="{l:Loc Struct_GroupingPoints}" FontWeight="SemiBold" Margin="0,8,0,0" />

                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Struct_GroupPlaneBy}" VerticalAlignment="Center" FontSize="12" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="Structural.Grouping" AutomationProperties.Name="{l:Loc Struct_GroupPlaneBy}"
                                      ItemsSource="{Binding Structural.GroupingModes}"
                                      SelectedItem="{Binding Structural.Grouping}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Struct_SplayShots}" VerticalAlignment="Center" FontSize="12" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="Structural.Splays" AutomationProperties.Name="{l:Loc Struct_SplayShots}"
                                      ItemsSource="{Binding Structural.SplayPolicies}"
                                      SelectedItem="{Binding Structural.Splays}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <CheckBox Content="{l:Loc Struct_IncludeOrigin}"
                                  AutomationProperties.AutomationId="Structural.IncludeOrigin"
                                  IsChecked="{Binding Structural.IncludeOriginPoint}" />
                        <TextBlock Text="{l:Loc Struct_IncludeOriginHelp}"
                                   Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="22,0,0,0" />

                        <TextBlock Text="{l:Loc Struct_MagDeclination}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Struct_Source}" VerticalAlignment="Center" FontSize="12" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="Structural.DeclinationSource" AutomationProperties.Name="{l:Loc Struct_Source}"
                                      ItemsSource="{Binding Structural.DeclinationSources}"
                                      SelectedItem="{Binding Structural.DeclinationSource}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Struct_ValueEast}" VerticalAlignment="Center" FontSize="12"
                                       IsVisible="{Binding Structural.DeclinationIsManual}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Structural.DeclinationDegrees}"
                                     AutomationProperties.AutomationId="Structural.DeclinationDegrees" AutomationProperties.Name="{l:Loc Struct_ValueEast}"
                                     IsVisible="{Binding Structural.DeclinationIsManual}" Watermark="0.0" />
                        </Grid>
                        <TextBlock Text="{l:Loc Struct_DeclinationHelp}"
                                   Foreground="Gray" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2 · Measurements -->
            <TabItem AutomationProperties.AutomationId="Structural.Tab.Measurements" Header="{l:Loc Struct_Tab2}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="2,2,2,4">
                        <Button Command="{Binding Structural.CheckAllCommand}" Padding="6,2" FontSize="12"
                                AutomationProperties.AutomationId="Structural.Measurements.CheckAll"
                                ToolTip.Tip="{l:Loc Struct_CheckAll}" Content="{l:Loc Struct_All}" />
                        <Button Command="{Binding Structural.CheckNoneCommand}" Padding="6,2" FontSize="12"
                                AutomationProperties.AutomationId="Structural.Measurements.CheckNone"
                                ToolTip.Tip="{l:Loc Struct_CheckNone}" Content="{l:Loc Struct_NoneBtn}" />
                        <Button Command="{Binding Structural.InvertSelectionCommand}" Padding="6,2" FontSize="12"
                                AutomationProperties.AutomationId="Structural.Measurements.Invert"
                                ToolTip.Tip="{l:Loc Struct_InvertSel}" Content="{l:Loc Struct_Invert}" />
                        <CheckBox Content="{l:Loc Struct_GroupByStation}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Measurements.GroupByStation"
                                  IsChecked="{Binding Structural.GroupByStation}" />
                        <!-- Full station name toggle (identical behaviour to the .th editor's measurements tab). -->
                        <ToggleButton Padding="6,3" VerticalAlignment="Center" Margin="6,0,0,0"
                                      AutomationProperties.AutomationId="Structural.Measurements.FullStationName" AutomationProperties.Name="{l:Loc Common_FullStationName}"
                                      ToolTip.Tip="{l:Loc Common_FullStationName}"
                                      IsChecked="{Binding Structural.ShowFullStationName, Mode=TwoWay}">
                            <PathIcon Data="{DynamicResource Icon.NodeGraph}" Width="14" Height="14" />
                        </ToggleButton>
                        <Button AutomationProperties.AutomationId="Structural.Measurements.Columns" Content="{l:Loc Common_Columns}" Padding="6,2" FontSize="11" ToolTip.Tip="{l:Loc Common_ShowHideColumns}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Name="MeasColumnsPanel" Spacing="2">
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Use" Content="{l:Loc Struct_Col_Use}"    Tag="Use"     Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Plane" Content="{l:Loc Struct_Col_Plane}"  Tag="Plane"   Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Kind" Content="{l:Loc Browser_Col_Kind}"  Tag="Kind"    Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.From" Content="{l:Loc Browser_Col_From}"  Tag="From"    Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.To" Content="{l:Loc Browser_Col_To}"    Tag="To"      Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Length" Content="{l:Loc Browser_Col_Length}" Tag="Length" Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Azimuth" Content="{l:Loc Struct_Col_Azimuth}" Tag="Azimuth" Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Clino" Content="{l:Loc Browser_Col_Clino}" Tag="Clino"   Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Comment" Content="{l:Loc Common_Comment}"    Tag="Comment" Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.File" Content="{l:Loc Common_File}"       Tag="File"    Click="OnToggleMeasColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Measurements.Columns.Line" Content="{l:Loc Browser_Col_Line}"  Tag="Line"    Click="OnToggleMeasColumn" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button AutomationProperties.AutomationId="Structural.Measurements.FitColumns" Content="{l:Loc Common_FitPlain}" Padding="6,2" FontSize="11" Click="OnFitMeasColumns" ToolTip.Tip="{l:Loc Common_AutoSize}" />
                        <Button Content="{l:Loc Common_ExportCsv}" Padding="6,2" FontSize="11" Click="OnExportMeasCsv"
                                AutomationProperties.AutomationId="Structural.Measurements.ExportCsv"
                                ToolTip.Tip="{l:Loc Struct_ExportMeasTip}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2,2,2,6" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="{l:Loc Struct_MeasHelp}" />
                    <!-- ItemsSource (a grouped DataGridCollectionView) is set in code-behind so grouping can toggle. -->
                    <DataGrid Name="MeasurementsGrid"
                              AutomationProperties.AutomationId="Structural.Measurements.Grid"
                              IsReadOnly="False" CanUserSortColumns="True" CanUserResizeColumns="True"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal" DoubleTapped="OnMeasurementDoubleTapped"
                              RowGroupTheme="{StaticResource StationGroupHeaderTheme}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem AutomationProperties.AutomationId="Structural.Measurements.Grid.CopyValue" Header="{l:Loc Common_CopyValue}" Click="OnCopyMeasValue" />
                                <MenuItem AutomationProperties.AutomationId="Structural.Measurements.Grid.CopyRow" Header="{l:Loc Common_CopyRow}" Click="OnCopyMeasRow" />
                                <MenuItem AutomationProperties.AutomationId="Structural.Measurements.Grid.CopyFormatted" Header="{l:Loc Common_CopyFormatted}" Click="OnCopyMeasFormatted" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <!-- ReflectionBinding: ItemsSource is a (non-generic) grouped view set in code-behind,
                             so columns resolve against the row item at runtime, not the UserControl's x:DataType.
                             Column order MUST stay in sync with MeasColOrder in the code-behind. -->
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{l:Loc Struct_Col_Use}" Binding="{ReflectionBinding Include}" Width="Auto" MinWidth="40" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Plane}" Binding="{ReflectionBinding Plane}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_Kind}" Binding="{ReflectionBinding Kind}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_From}" Binding="{ReflectionBinding From}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_To}" Binding="{ReflectionBinding To}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_Length}" Binding="{ReflectionBinding Length}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Azimuth}" Binding="{ReflectionBinding Compass}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_Clino}" Binding="{ReflectionBinding Clino}" IsReadOnly="True" Width="Auto" />
                            <!-- Comment clipped to ~25 chars (full text in the tooltip); keeps Fit from ballooning. -->
                            <DataGridTemplateColumn Header="{l:Loc Common_Comment}" IsReadOnly="True" Width="Auto" SortMemberPath="Comment">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{ReflectionBinding CommentShort}" VerticalAlignment="Center"
                                                   Padding="4,0" ToolTip.Tip="{ReflectionBinding Comment}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Common_File}" Binding="{ReflectionBinding File}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_Line}" Binding="{ReflectionBinding Line}" IsReadOnly="True" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 3 · Resulted planes -->
            <TabItem AutomationProperties.AutomationId="Structural.Tab.Planes" Header="{l:Loc Struct_Tab3}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="2,2,2,4">
                        <!-- Plot visibility bulk toggles (mirror the measurements grid's All/None/Invert). -->
                        <TextBlock Text="{l:Loc Struct_VisibleLabel}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,2,0" />
                        <Button Content="{l:Loc Struct_All}" Command="{Binding Structural.ShowAllPlanesCommand}" Padding="6,2" FontSize="12"
                                AutomationProperties.AutomationId="Structural.Planes.ShowAll"
                                ToolTip.Tip="{l:Loc Struct_ShowAllPlanes}" />
                        <Button Content="{l:Loc Struct_NoneBtn}" Command="{Binding Structural.HideAllPlanesCommand}" Padding="6,2" FontSize="12"
                                AutomationProperties.AutomationId="Structural.Planes.HideAll"
                                ToolTip.Tip="{l:Loc Struct_HideAllPlanes}" />
                        <Button Content="{l:Loc Struct_Invert}" Command="{Binding Structural.InvertPlaneVisibilityCommand}" Padding="6,2" FontSize="12"
                                AutomationProperties.AutomationId="Structural.Planes.Invert"
                                ToolTip.Tip="{l:Loc Struct_InvertPlanes}" />
                        <!-- Push button: overlay the visible planes on the Mainline Preview as strike/dip lines. -->
                        <ToggleButton Content="{l:Loc Struct_ShowInPreview}" Padding="6,2" FontSize="12"
                                      AutomationProperties.AutomationId="Structural.Planes.ShowInPreview"
                                      IsChecked="{Binding Structural.ShowPlanesInPreview, Mode=TwoWay}"
                                      ToolTip.Tip="{l:Loc Struct_ShowInPreviewTip}" />
                        <Border Width="1" Margin="6,2" Background="Gray" />
                        <Button AutomationProperties.AutomationId="Structural.Planes.Columns" Content="{l:Loc Common_Columns}" Padding="6,2" FontSize="11" ToolTip.Tip="{l:Loc Common_ShowHideColumns}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Name="PlaneColumnsPanel" Spacing="2">
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Plane" Content="{l:Loc Struct_Col_Plane}"    Tag="Plane"      Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Type" Content="{l:Loc Struct_Col_Type}"     Tag="Type"       Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Dip" Content="{l:Loc Struct_Col_Dip}"      Tag="Dip °"      Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Strike" Content="{l:Loc Struct_Col_Strike}"   Tag="Strike °"   Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.DipDirection" Content="{l:Loc Struct_Col_DipDir}"   Tag="Dip dir °"  Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.NorthRef" Content="{l:Loc Struct_Col_NorthRef}" Tag="North ref"  Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Points" Content="{l:Loc Struct_Col_Points}"   Tag="Points"     Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Rms" Content="{l:Loc Struct_Col_Rms}"      Tag="RMS"        Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.File" Content="{l:Loc Common_File}"         Tag="File"       Click="OnTogglePlaneColumn" />
                                        <CheckBox AutomationProperties.AutomationId="Structural.Planes.Columns.Line" Content="{l:Loc Browser_Col_Line}"    Tag="Line"       Click="OnTogglePlaneColumn" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button AutomationProperties.AutomationId="Structural.Planes.FitColumns" Content="{l:Loc Common_FitPlain}" Padding="6,2" FontSize="11" Click="OnFitPlaneColumns" ToolTip.Tip="{l:Loc Common_AutoSize}" />
                        <Button Content="{l:Loc Common_ExportCsv}" Padding="6,2" FontSize="11" Click="OnExportPlanesCsv"
                                AutomationProperties.AutomationId="Structural.Planes.ExportCsv"
                                ToolTip.Tip="{l:Loc Struct_ExportPlanesTip}" />
                    </StackPanel>
                    <DataGrid Name="PlanesGrid" ItemsSource="{Binding Structural.Planes}"
                              AutomationProperties.AutomationId="Structural.Planes.Grid"
                              SelectedItem="{Binding Structural.SelectedPlane}"
                              IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal" DoubleTapped="OnPlaneDoubleTapped">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem AutomationProperties.AutomationId="Structural.Planes.Grid.HighlightInPreview" Header="{l:Loc Struct_HighlightInPreview}" Click="OnHighlightPlaneInPreview" />
                                <MenuItem AutomationProperties.AutomationId="Structural.Planes.Grid.GoToSource" Header="{l:Loc Common_GoToSource}" Click="OnGoToPlaneSource" />
                                <Separator />
                                <MenuItem AutomationProperties.AutomationId="Structural.Planes.Grid.CopyValue" Header="{l:Loc Common_CopyValue}" Click="OnCopyPlaneValue" />
                                <MenuItem AutomationProperties.AutomationId="Structural.Planes.Grid.CopyRow" Header="{l:Loc Common_CopyRow}" Click="OnCopyPlaneRow" />
                                <MenuItem AutomationProperties.AutomationId="Structural.Planes.Grid.CopyFormatted" Header="{l:Loc Common_CopyFormatted}" Click="OnCopyPlaneFormatted" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <!-- Column order MUST stay in sync with PlaneColOrder in the code-behind. -->
                        <DataGrid.Columns>
                            <!-- Checkbox works even though the grid is read-only (template control, not a cell editor). -->
                            <DataGridTemplateColumn Header="{l:Loc Struct_Col_Visible}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" HorizontalAlignment="Center"
                                                  ToolTip.Tip="{l:Loc Struct_PlaneDiscTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Plane}" Binding="{Binding Name}" Width="Auto" />
                            <!-- Editable free-text with predefined suggestions (Fault / Bedding plane / Joint);
                                 drives the per-type colouring of the plane line in the Mainline Preview. -->
                            <DataGridTemplateColumn Header="{l:Loc Struct_Col_Type}" Width="Auto" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <AutoCompleteBox Text="{Binding Type, Mode=TwoWay}"
                                                         ItemsSource="{Binding TypeSuggestions}"
                                                         FilterMode="Contains" MinimumPrefixLength="0"
                                                         Watermark="{l:Loc Struct_TypeWatermark}"
                                                         Padding="2" Margin="1" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Dip}" Binding="{Binding Dip}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Strike}" Binding="{Binding Strike}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_DipDir}" Binding="{Binding DipDirection}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_NorthRef}" Binding="{Binding Declination}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Points}" Binding="{Binding Points}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Struct_Col_Rms}" Binding="{Binding Quality}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Common_File}" Binding="{Binding File}" Width="Auto" />
                            <DataGridTextColumn Header="{l:Loc Browser_Col_Line}" Binding="{Binding Line}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 4 · Plot (hidden once popped out into its own panel; see PopOutPlot) -->
            <TabItem AutomationProperties.AutomationId="Structural.Tab.Plot" Header="{l:Loc Struct_Tab4}" IsVisible="{Binding !Structural.PlotPoppedOut}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="2">
                        <Button AutomationProperties.AutomationId="Structural.Plot.FitView" Content="{l:Loc Struct_FitView}" Click="OnFitView" Padding="8,2" FontSize="11" />
                        <Button Content="{l:Loc Struct_ExportImage}" Click="OnExportImage" Padding="8,2" FontSize="11"
                                AutomationProperties.AutomationId="Structural.Plot.ExportImage"
                                ToolTip.Tip="{l:Loc Struct_ExportImageTip}" />
                        <TextBlock Text="{l:Loc Struct_DiscSize}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding Structural.DiscScales}"
                                  AutomationProperties.AutomationId="Structural.Plot.DiscSize" AutomationProperties.Name="{l:Loc Struct_DiscSizeTip}"
                                  SelectedItem="{Binding Structural.DiscScale}" FontSize="11" MinWidth="64"
                                  ToolTip.Tip="{l:Loc Struct_DiscSizeTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat='{}{0}×'}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="{l:Loc Struct_WhiteBackground}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Plot.WhiteBackground"
                                  IsChecked="{Binding Structural.WhiteBackground}" />
                        <CheckBox Content="{l:Loc Struct_ShowSplays}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Plot.ShowSplays"
                                  IsChecked="{Binding Structural.PlotSplays}" ToolTip.Tip="{l:Loc Struct_ShowSplaysTip}" />
                        <CheckBox Content="{l:Loc Struct_FadedSplays}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Plot.FadedSplays"
                                  IsChecked="{Binding Structural.FadedSplays}" IsEnabled="{Binding Structural.PlotSplays}"
                                  ToolTip.Tip="{l:Loc Struct_FadedSplaysTip}" />
                        <CheckBox Content="{l:Loc Struct_NetInPlot}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Plot.NetInPlot"
                                  IsChecked="{Binding Structural.NetInPlot}" ToolTip.Tip="{l:Loc Struct_NetInPlotTip}" />
                        <Border Width="1" Margin="6,2" Background="Gray" />
                        <!-- Mirrors the Resulted Planes tab's push button (same bound property). -->
                        <ToggleButton Content="{l:Loc Struct_ShowInPreview}" Padding="6,2" FontSize="12"
                                      AutomationProperties.AutomationId="Structural.Plot.ShowInPreview"
                                      IsChecked="{Binding Structural.ShowPlanesInPreview, Mode=TwoWay}"
                                      ToolTip.Tip="{l:Loc Struct_ShowInPreviewTip}" />
                        <Button Content="{l:Loc Struct_PopOutPlot}" Command="{Binding Structural.PopOutPlotCommand}"
                                AutomationProperties.AutomationId="Structural.Plot.PopOut"
                                Padding="8,2" FontSize="11" ToolTip.Tip="{l:Loc Struct_PopOutPlotTip}" />
                    </StackPanel>
                    <Panel>
                        <Panel AutomationProperties.AutomationId="Structural.Plot.Host" Name="PlotHost" />
                        <Border Name="PlotFallback" IsVisible="False"
                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Margin="24" Foreground="Gray" TextAlignment="Center"
                                       Text="{l:Loc Struct_PlotFallback}" />
                        </Border>
                    </Panel>
                </DockPanel>
            </TabItem>

            <!-- 5 · Stereonet (Wulff / Schmidt; hidden once popped out — see PopOutStereonet) -->
            <TabItem AutomationProperties.AutomationId="Structural.Tab.Stereonet" Header="{l:Loc Struct_Tab5}" IsVisible="{Binding !Structural.StereonetPoppedOut}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="2">
                        <TextBlock Text="{l:Loc Struct_NetProjection}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding Structural.NetProjections}"
                                  AutomationProperties.AutomationId="Structural.Stereonet.Projection" AutomationProperties.Name="{l:Loc Struct_NetProjectionTip}"
                                  SelectedItem="{Binding Structural.NetProjection}" FontSize="11" MinWidth="150"
                                  ToolTip.Tip="{l:Loc Struct_NetProjectionTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource NetProjLabel}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="{l:Loc Struct_NetPoles}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Stereonet.Poles"
                                  IsChecked="{Binding Structural.NetShowPoles}" ToolTip.Tip="{l:Loc Struct_NetPolesTip}" />
                        <CheckBox Content="{l:Loc Struct_NetMeasurements}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Stereonet.Measurements"
                                  IsChecked="{Binding Structural.NetShowMeasurements}" ToolTip.Tip="{l:Loc Struct_NetMeasurementsTip}" />
                        <CheckBox Content="{l:Loc Struct_NetGrid}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Stereonet.Grid"
                                  IsChecked="{Binding Structural.NetShowGrid}" ToolTip.Tip="{l:Loc Struct_NetGridTip}" />
                        <CheckBox Content="{l:Loc Struct_NetLabels}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Stereonet.Labels"
                                  IsChecked="{Binding Structural.NetShowLabels}" />
                        <CheckBox Content="{l:Loc Struct_WhiteBackground}" FontSize="11" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Structural.Stereonet.WhiteBackground"
                                  IsChecked="{Binding Structural.NetWhiteBackground}" />
                        <Border Width="1" Margin="6,2" Background="Gray" />
                        <Button Content="{l:Loc Struct_ExportImage}" Click="OnExportStereonet" Padding="8,2" FontSize="11"
                                AutomationProperties.AutomationId="Structural.Stereonet.ExportImage"
                                ToolTip.Tip="{l:Loc Struct_NetExportTip}" />
                        <Button Content="{l:Loc Struct_PopOutNet}" Command="{Binding Structural.PopOutStereonetCommand}"
                                AutomationProperties.AutomationId="Structural.Stereonet.PopOut"
                                Padding="8,2" FontSize="11" ToolTip.Tip="{l:Loc Struct_PopOutNetTip}" />
                    </StackPanel>
                    <v:StereonetControl AutomationProperties.AutomationId="Structural.Stereonet.Net" Name="NetControl" Model="{Binding Structural.StereonetModel}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
