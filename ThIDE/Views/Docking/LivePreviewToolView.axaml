<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThIDE.ViewModels.Docking"
             xmlns:views="using:ThIDE.Views"
             xmlns:docking="using:ThIDE.Views.Docking"
             x:Class="ThIDE.Views.Docking.LivePreviewToolView"
             x:CompileBindings="False"
             AutomationProperties.AutomationId="LivePreview.View"
             x:DataType="vm:LivePreviewToolViewModel">
    <views:LivePreviewView DataContext="{Binding Preview}">
        <views:LivePreviewView.ToolbarExtra>
            <docking:PanelWindowControls x:Name="WindowControls" Orientation="Vertical"
                                         AutomationProperties.AutomationId="LivePreview.WindowControls"
                                         VerticalAlignment="Top" Margin="4,0,0,0" />
        </views:LivePreviewView.ToolbarExtra>
    </views:LivePreviewView>
</UserControl>
