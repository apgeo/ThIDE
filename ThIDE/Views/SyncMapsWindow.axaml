<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThIDE.ViewModels"
        xmlns:l="using:ThIDE.Resources"
        x:Class="ThIDE.Views.SyncMapsWindow"
        x:DataType="vm:SyncMapsViewModel"
        x:CompileBindings="False"
        Title="{l:Loc Menu_Tools_SyncMaps}" Width="720" Height="520" MinWidth="480" MinHeight="300"
        AutomationProperties.AutomationId="SyncMaps.Window"
        WindowStartupLocation="CenterOwner" CanResize="True">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc SyncMaps_Intro}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="{l:Loc Common_Cancel}" Click="OnCancel" MinWidth="80" AutomationProperties.AutomationId="SyncMaps.Cancel" />
            <Button Content="{l:Loc SyncMaps_Next}" Click="OnNext" IsDefault="True" MinWidth="110" AutomationProperties.AutomationId="SyncMaps.Next" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="SyncMaps.Rows">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="200,*,220">
                        <TextBlock Text="{Binding ScrapId}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding File}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Maps}" SelectedItem="{Binding Map, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
