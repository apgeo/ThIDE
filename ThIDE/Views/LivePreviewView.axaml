<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThIDE.ViewModels"
             xmlns:views="using:ThIDE.Views"
             xmlns:conv="using:ThIDE.Converters"
             xmlns:l="using:ThIDE.Resources"
             x:Class="ThIDE.Views.LivePreviewView"
             x:CompileBindings="False"
             x:DataType="vm:LivePreviewViewModel">
    <!-- The Mainline Preview itself — toolbar, sketch and legend — bound straight to a
         LivePreviewViewModel, so the dock panel and dialogs host the same view. -->
    <UserControl.Resources>
        <conv:StringEqualsConverter x:Key="ColorEquals" />
        <conv:BoolAndConverter x:Key="BoolAnd" />
    </UserControl.Resources>
    <DockPanel>
        <Border AutomationProperties.AutomationId="LivePreview.Toolbar" DockPanel.Dock="Top"
                IsVisible="{Binding IsToolbarVisible, RelativeSource={RelativeSource AncestorType=views:LivePreviewView}}" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="6,3">
          <DockPanel>
            <ContentControl DockPanel.Dock="Right" VerticalAlignment="Top"
                            Content="{Binding ToolbarExtra, RelativeSource={RelativeSource AncestorType=views:LivePreviewView}}" />
            <WrapPanel Orientation="Horizontal">
                <!-- View: plan, or a projected profile along a bearing (radio-style push buttons). -->
                <TextBlock Text="{l:Loc M3D_View}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,4,0" />
                <ToggleButton Content="{l:Loc M3D_Plan}" Command="{Binding SetViewModeCommand}" CommandParameter="plan"
                              AutomationProperties.AutomationId="LivePreview.ViewPlan"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=plan}"
                              ToolTip.Tip="{l:Loc Live_PlanTip}" FontSize="11" Padding="8,2" Margin="0,0,6,2" />
                <!-- Projected profile: one button per cardinal bearing (the section extends along it). -->
                <ToggleButton Content="N" Command="{Binding SetViewModeCommand}" CommandParameter="north"
                              AutomationProperties.AutomationId="LivePreview.ViewNorth" AutomationProperties.Name="{l:Loc Live_ProfN}"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=north}"
                              ToolTip.Tip="{l:Loc Live_ProfN}" FontSize="11" Padding="8,2" Margin="0,0,2,2" />
                <ToggleButton Content="E" Command="{Binding SetViewModeCommand}" CommandParameter="east"
                              AutomationProperties.AutomationId="LivePreview.ViewEast" AutomationProperties.Name="{l:Loc Live_ProfE}"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=east}"
                              ToolTip.Tip="{l:Loc Live_ProfE}" FontSize="11" Padding="8,2" Margin="0,0,2,2" />
                <ToggleButton Content="S" Command="{Binding SetViewModeCommand}" CommandParameter="south"
                              AutomationProperties.AutomationId="LivePreview.ViewSouth" AutomationProperties.Name="{l:Loc Live_ProfS}"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=south}"
                              ToolTip.Tip="{l:Loc Live_ProfS}" FontSize="11" Padding="8,2" Margin="0,0,2,2" />
                <ToggleButton Content="W" Command="{Binding SetViewModeCommand}" CommandParameter="west"
                              AutomationProperties.AutomationId="LivePreview.ViewWest" AutomationProperties.Name="{l:Loc Live_ProfW}"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=west}"
                              ToolTip.Tip="{l:Loc Live_ProfW}" FontSize="11" Padding="8,2" Margin="0,0,2,2" />
                <ToggleButton Content="{l:Loc Live_Custom}" Command="{Binding SetViewModeCommand}" CommandParameter="custom"
                              AutomationProperties.AutomationId="LivePreview.ViewCustom"
                              IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=custom}"
                              ToolTip.Tip="{l:Loc Live_CustomTip}" FontSize="11" Padding="8,2" Margin="0,0,4,2" />
                <!-- Custom-bearing slider (0–359°): live-updates the projection as it moves. -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,2"
                            IsVisible="{Binding IsCustomProfile}">
                    <Slider Width="130" Minimum="0" Maximum="359" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="LivePreview.Bearing" AutomationProperties.Name="{l:Loc Live_BearingTip}"
                            Value="{Binding CustomAzimuth, Mode=TwoWay}"
                            ToolTip.Tip="{l:Loc Live_BearingTip}" />
                    <TextBlock Text="{Binding CustomAzimuth, StringFormat='{}{0:0}°'}"
                               VerticalAlignment="Center" FontSize="11" Foreground="Gray" MinWidth="30" />
                </StackPanel>
                <Button AutomationProperties.AutomationId="LivePreview.Refresh" AutomationProperties.Name="{l:Loc Common_Refresh}" Content="{l:Loc Common_RefreshGlyph}" Command="{Binding RefreshCommand}" FontSize="11" Padding="8,2" Margin="0,0,6,2" />

                <Separator Width="1" Margin="3,2" Background="Gray" />

                <!-- Splays: show + draw mode (faded lines vs edge points only). -->
                <ToggleButton Content="{l:Loc M3D_Splays}" IsChecked="{Binding ShowSplays, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.Splays"
                              ToolTip.Tip="{l:Loc Live_SplaysTip}" FontSize="11" Padding="6,2" Margin="0,0,2,2" />
                <ToggleButton Content="{l:Loc Live_AsLines}" IsChecked="{Binding SplaysAsLines, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.SplaysAsLines"
                              IsEnabled="{Binding ShowSplays}"
                              ToolTip.Tip="{l:Loc Live_AsLinesTip}" FontSize="11" Padding="6,2" Margin="0,0,6,2" />

                <Separator Width="1" Margin="3,2" Background="Gray" />

                <!-- Debug overlays: station labels + provenance colouring. -->
                <ToggleButton Content="{l:Loc M3D_Labels}" IsChecked="{Binding ShowStationLabels, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.StationLabels"
                              ToolTip.Tip="{l:Loc Live_LabelsTip}" FontSize="11" Padding="6,2" Margin="0,0,2,2" />
                <ToggleButton Content="survey.station" IsChecked="{Binding ShowSurveyNames, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.SurveyNames"
                              ToolTip.Tip="{l:Loc Live_SurveyStationTip}" FontSize="11" Padding="6,2" Margin="0,0,2,2" />
                <ToggleButton Content="{l:Loc Browser_Tab_Stations}" IsChecked="{Binding ShowStationSymbols, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.StationSymbols"
                              ToolTip.Tip="{l:Loc Live_StationsTip}" FontSize="11" Padding="6,2" Margin="0,0,2,2" />
                <ToggleButton Content="{l:Loc Live_Junctions}" IsChecked="{Binding ShowJunctions, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.Junctions"
                              ToolTip.Tip="{l:Loc Live_JunctionsTip}"
                              FontSize="11" Padding="6,2" Margin="0,0,2,2" />
                <ToggleButton Content="{l:Loc Live_Legend}" IsChecked="{Binding ShowLegend, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.Legend"
                              ToolTip.Tip="{l:Loc Live_LegendTip}"
                              FontSize="11" Padding="6,2" Margin="0,0,2,2" />
                <ToggleButton Content="{l:Loc Live_Separate}" IsChecked="{Binding SeparateComponents, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.SeparateComponents"
                              ToolTip.Tip="{l:Loc Live_SeparateTip}"
                              FontSize="11" Padding="6,2" Margin="0,0,6,2" />

                <Separator Width="1" Margin="3,2" Background="Gray" />

                <!-- Mirrors the Structural Geology panel's "Show in Mainline Map Preview" toggles
                     (same bound state, renamed here per the Mainline Preview's own terminology). -->
                <ToggleButton Content="{l:Loc Live_ShowStructurePlanes}" IsChecked="{Binding ShowPlanesInPreview, Mode=TwoWay}"
                              AutomationProperties.AutomationId="LivePreview.StructurePlanes"
                              ToolTip.Tip="{l:Loc Struct_ShowInPreviewTip}" FontSize="11" Padding="6,2" Margin="0,0,6,2" />

                <Separator Width="1" Margin="3,2" Background="Gray" />

                <!-- Colour legs by data origin (also buckets the legend / visibility groups). -->
                <TextBlock Text="{l:Loc Live_Color}" VerticalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,4,0" />
                <ToggleButton Content="{l:Loc Live_None}" Command="{Binding SetColorModeCommand}" CommandParameter="none" FontSize="11" Padding="6,2" Margin="0,0,2,2"
                              AutomationProperties.AutomationId="LivePreview.ColorNone"
                              IsChecked="{Binding ColorMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=none}" />
                <ToggleButton Content="{l:Loc Domain_Survey}" Command="{Binding SetColorModeCommand}" CommandParameter="survey" FontSize="11" Padding="6,2" Margin="0,0,2,2"
                              AutomationProperties.AutomationId="LivePreview.ColorSurvey"
                              ToolTip.Tip="{l:Loc Live_ColSurveyTip}"
                              IsChecked="{Binding ColorMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=survey}" />
                <ToggleButton Content="{l:Loc Common_File}" Command="{Binding SetColorModeCommand}" CommandParameter="file" FontSize="11" Padding="6,2" Margin="0,0,2,2"
                              AutomationProperties.AutomationId="LivePreview.ColorFile"
                              ToolTip.Tip="{l:Loc Live_ColFileTip}"
                              IsChecked="{Binding ColorMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=file}" />
                <ToggleButton Content="{l:Loc Live_Component}" Command="{Binding SetColorModeCommand}" CommandParameter="component" FontSize="11" Padding="6,2" Margin="0,0,6,2"
                              AutomationProperties.AutomationId="LivePreview.ColorComponent"
                              ToolTip.Tip="{l:Loc Live_ComponentTip}"
                              IsChecked="{Binding ColorMode, Mode=OneWay, Converter={StaticResource ColorEquals}, ConverterParameter=component}" />

                <TextBlock Text="{Binding Status}" Foreground="Gray" VerticalAlignment="Center"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
            </WrapPanel>
          </DockPanel>
        </Border>

        <Grid>
            <views:LivePreviewControl x:Name="Sketch" Segments="{Binding Segments}"
                                      AutomationProperties.AutomationId="LivePreview.Sketch"
                                      AllSegments="{Binding FullSegments}"
                                      AllSplays="{Binding FullSplays}"
                                      Splays="{Binding Splays}"
                                      SplaysAsLines="{Binding SplaysAsLines}"
                                      StationPoints="{Binding StationPoints}"
                                      LeadMarkers="{Binding LeadMarkers}"
                                      EquateMarkers="{Binding EquateMarkers}"
                                      PlaneLines="{Binding PlaneLines}"
                                      ShowJunctions="{Binding ShowJunctions}"
                                      ShowSplays="{Binding ShowSplays}"
                                      ShowStationSymbols="{Binding ShowStationSymbols}"
                                      ShowLabels="{Binding ShowStationLabels}"
                                      ShowSurveyNames="{Binding ShowSurveyNames}"
                                      ShowNorthArrow="{Binding IsPlan}"
                                      ColorMode="{Binding ColorMode}"
                                      EmphasizedFile="{Binding EmphasizedFile}"
                                      HighlightedStations="{Binding HighlightedStations}" />

            <!-- Drawing-area caption (top-right): "Plan view" / "Projected profile view (N/E/S/W)" /
                 "… (toward <az>°)". Click-through so it never blocks the sketch. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                    Background="#E62B2B2B" CornerRadius="4" Padding="7,3" IsHitTestVisible="False"
                    BoxShadow="0 1 4 0 #40000000">
                <TextBlock Text="{Binding ViewLabel}" FontSize="11" FontWeight="SemiBold"
                           Foreground="#EEEEEE" />
            </Border>

            <!-- Shown only while the structural-plane overlay is on: hints that the lines are clickable. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                    Background="#E62B2B2B" CornerRadius="4" Padding="7,3" IsHitTestVisible="False"
                    BoxShadow="0 1 4 0 #40000000" IsVisible="{Binding ShowPlanesInPreview}">
                <TextBlock Text="{l:Loc Live_ClickToHighlightHint}" FontSize="11" FontWeight="SemiBold"
                           Foreground="#EEEEEE" />
            </Border>

            <!-- Interactive legend = the per-survey/file/component visibility list. Hover a row to
                 frame that group in the sketch. Shown only when enabled and there's >1 group. -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                    Background="#E62B2B2B" CornerRadius="4" Padding="6,5" BoxShadow="0 1 4 0 #40000000">
                <Border.IsVisible>
                    <MultiBinding Converter="{StaticResource BoolAnd}">
                        <Binding Path="ShowLegend" />
                        <Binding Path="HasGroups" />
                    </MultiBinding>
                </Border.IsVisible>
                <DockPanel MaxWidth="220">
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Live_Groups}" FontWeight="SemiBold" FontSize="11"
                               Foreground="#EEEEEE" Margin="0,0,0,3" />
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,4">
                        <!-- The overlay backdrop is dark (#2B2B2B); give these buttons a light,
                             contrasting fill + text so they don't disappear into it. -->
                        <UniformGrid.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="#F0F0F0" />
                                <Setter Property="Background" Value="#5A5A5A" />
                                <Setter Property="BorderBrush" Value="#8A8A8A" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#5A5A5A" />
                                <Setter Property="BorderBrush" Value="#8A8A8A" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#767676" />
                                <Setter Property="BorderBrush" Value="#AFAFAF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Style>
                        </UniformGrid.Styles>
                        <Button Content="{l:Loc Live_All}" Command="{Binding ShowAllGroupsCommand}" FontSize="10" Padding="4,0" Margin="0,0,2,0"
                                AutomationProperties.AutomationId="LivePreview.Groups.ShowAll"
                                ToolTip.Tip="{l:Loc Live_AllTip}" />
                        <Button Content="{l:Loc Live_NoneBtn}" Command="{Binding HideAllGroupsCommand}" FontSize="10" Padding="4,0" Margin="0,0,2,0"
                                AutomationProperties.AutomationId="LivePreview.Groups.HideAll"
                                ToolTip.Tip="{l:Loc Live_NoneTip}" />
                        <Button Content="{l:Loc Live_Invert}" Command="{Binding InvertGroupsCommand}" FontSize="10" Padding="4,0" Margin="0,0,2,0"
                                AutomationProperties.AutomationId="LivePreview.Groups.Invert"
                                ToolTip.Tip="{l:Loc Live_InvertTip}" />
                        <Button Content="{l:Loc Live_Main}" Command="{Binding ShowOnlyMainCommand}" FontSize="10" Padding="4,0"
                                AutomationProperties.AutomationId="LivePreview.Groups.ShowMain"
                                ToolTip.Tip="{l:Loc Live_MainTip}" />
                    </UniformGrid>
                    <ScrollViewer x:Name="GroupScroller" MaxHeight="260" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
                        <!-- Right margin reserves space so the always-on scrollbar never sits over the titles. -->
                        <ItemsControl AutomationProperties.AutomationId="LivePreview.Groups.List" x:Name="GroupList" ItemsSource="{Binding Groups}" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1" Background="Transparent"
                                          ToolTip.Tip="{l:Loc Live_GroupRowTip}">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  MinWidth="0" Padding="0" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="11" Height="11" CornerRadius="2"
                                                Background="{Binding Swatch}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="11" Foreground="#EEEEEE"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
