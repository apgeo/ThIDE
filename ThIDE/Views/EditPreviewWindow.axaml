<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThIDE.ViewModels"
        xmlns:l="using:ThIDE.Resources"
        x:Class="ThIDE.Views.EditPreviewWindow"
        x:DataType="vm:EditPreviewViewModel"
        x:CompileBindings="False"
        Title="{Binding Title}" Width="900" Height="560" MinWidth="560" MinHeight="320"
        AutomationProperties.AutomationId="EditPreview.Window"
        WindowStartupLocation="CenterOwner" CanResize="True">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="EditPreview.Summary" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="{l:Loc Common_Cancel}" Click="OnCancel" MinWidth="80" AutomationProperties.AutomationId="EditPreview.Cancel" />
            <Button Content="{l:Loc EditPreview_Apply}" Click="OnApply" IsDefault="True" MinWidth="110"
                    AutomationProperties.AutomationId="EditPreview.Apply" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" AutomationProperties.AutomationId="EditPreview.Items">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,220,*">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Location}" Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4,4,8,0" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Before}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Foreground="#C62828" TextDecorations="Strikethrough" />
                            <TextBlock Text="{Binding After}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Foreground="#2E7D32" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
