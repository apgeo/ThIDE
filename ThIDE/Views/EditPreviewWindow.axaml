<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThIDE.ViewModels"
        xmlns:l="using:ThIDE.Resources"
        x:Class="ThIDE.Views.EditPreviewWindow"
        x:DataType="vm:EditPreviewViewModel"
        x:CompileBindings="False"
        Title="{Binding Title}" Width="900" Height="560" MinWidth="560" MinHeight="320"
        AutomationProperties.AutomationId="EditPreview.Window"
        WindowStartupLocation="CenterOwner" CanResize="True">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="EditPreview.Summary" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="{l:Loc Common_Cancel}" Click="OnCancel" IsCancel="True" MinWidth="80" AutomationProperties.AutomationId="EditPreview.Cancel"
                    IsVisible="{Binding !IsEmpty}" />
            <Button Content="{l:Loc EditPreview_Apply}" Click="OnApply" IsDefault="True" MinWidth="110"
                    AutomationProperties.AutomationId="EditPreview.Apply" IsVisible="{Binding !IsEmpty}" />
            <!-- An empty plan keeps the window open to say so; Close is then the only way out. -->
            <Button Content="{l:Loc Common_Close}" Click="OnClose" IsCancel="{Binding IsEmpty}" IsDefault="{Binding IsEmpty}" MinWidth="80"
                    AutomationProperties.AutomationId="EditPreview.Close" IsVisible="{Binding IsEmpty}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" AutomationProperties.AutomationId="EditPreview.Items" IsVisible="{Binding !IsEmpty}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,220,*">
                        <!-- All-or-nothing plans (a renumbering) have no choice to offer: no boxes then. -->
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top"
                                  IsVisible="{Binding $parent[Window].DataContext.CanChoose}" />
                        <TextBlock Grid.Column="1" Text="{Binding Location}" Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4,4,8,0" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Before}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Foreground="#C62828" TextDecorations="Strikethrough" IsVisible="{Binding ShowsLines}" />
                            <TextBlock Text="{Binding After}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Foreground="#2E7D32" IsVisible="{Binding ShowsLines}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
