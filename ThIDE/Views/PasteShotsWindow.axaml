<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThIDE.ViewModels"
        xmlns:l="using:ThIDE.Resources"
        x:Class="ThIDE.Views.PasteShotsWindow"
        x:DataType="vm:PasteShotsViewModel"
        x:CompileBindings="False"
        Title="{l:Loc PasteShots_Title}" Width="900" Height="620" MinWidth="600" MinHeight="400"
        AutomationProperties.AutomationId="PasteShots.Window"
        WindowStartupLocation="CenterOwner" CanResize="True">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc PasteShots_Intro}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Text="{l:Loc PasteShots_Columns}" VerticalAlignment="Center" Margin="0,0,8,4" />
            <TextBox Grid.Column="1" Text="{Binding Columns, Mode=TwoWay}" Watermark="{Binding DetectedColumns}" Margin="0,0,12,4"
                     AutomationProperties.AutomationId="PasteShots.Columns" />
            <TextBlock Grid.Column="2" Text="{l:Loc PasteShots_Start}" VerticalAlignment="Center" Margin="0,0,8,4" IsEnabled="{Binding NeedsStations}" />
            <TextBox Grid.Column="3" Text="{Binding StartStation, Mode=TwoWay}" IsEnabled="{Binding NeedsStations}" Margin="0,0,0,4"
                     AutomationProperties.AutomationId="PasteShots.Start" />
            <TextBlock Grid.Row="1" Text="{l:Loc PasteShots_Units}" VerticalAlignment="Center" Margin="0,0,8,4" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,12,4">
                <ComboBox SelectedIndex="{Binding LengthUnit, Mode=TwoWay}" MinWidth="140" AutomationProperties.AutomationId="PasteShots.LengthUnit">
                    <ComboBoxItem Content="{l:Loc PasteShots_LengthAuto}" />
                    <ComboBoxItem Content="{l:Loc PasteShots_Meters}" />
                    <ComboBoxItem Content="{l:Loc PasteShots_Feet}" />
                </ComboBox>
                <ComboBox SelectedIndex="{Binding AngleUnit, Mode=TwoWay}" MinWidth="140" AutomationProperties.AutomationId="PasteShots.AngleUnit">
                    <ComboBoxItem Content="{l:Loc PasteShots_AngleAuto}" />
                    <ComboBoxItem Content="{l:Loc PasteShots_Degrees}" />
                    <ComboBoxItem Content="{l:Loc PasteShots_Grads}" />
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:Loc PasteShots_Merge}" VerticalAlignment="Center" Margin="0,0,8,4" IsEnabled="{Binding NeedsStations}" />
            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding MergeRepeats, Mode=TwoWay}" Minimum="0" Maximum="10" Increment="1" FormatString="0"
                           IsEnabled="{Binding NeedsStations}" Margin="0,0,0,4" AutomationProperties.AutomationId="PasteShots.Merge" />
            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="{l:Loc PasteShots_Wrap}" IsChecked="{Binding Wrap, Mode=TwoWay}"
                      AutomationProperties.AutomationId="PasteShots.Wrap" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,12,0" AutomationProperties.AutomationId="PasteShots.Summary" />
            <Button Content="{l:Loc Common_Cancel}" Click="OnCancel" MinWidth="80" AutomationProperties.AutomationId="PasteShots.Cancel" />
            <Button Content="{l:Loc PasteShots_Insert}" Click="OnInsert" IsDefault="True" IsEnabled="{Binding CanInsert}" MinWidth="110"
                    AutomationProperties.AutomationId="PasteShots.Insert" />
        </StackPanel>
        <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding Issues}" MaxHeight="110" Margin="0,8,0,0" AutomationProperties.AutomationId="PasteShots.Issues" />
        <Grid ColumnDefinitions="*,8,*">
            <TextBox Text="{Binding Source, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" FontFamily="monospace" TextWrapping="NoWrap"
                     AutomationProperties.AutomationId="PasteShots.Source" />
            <TextBox Grid.Column="2" Text="{Binding Output}" IsReadOnly="True" FontFamily="monospace" TextWrapping="NoWrap"
                     AutomationProperties.AutomationId="PasteShots.Output" />
        </Grid>
    </DockPanel>
</Window>
