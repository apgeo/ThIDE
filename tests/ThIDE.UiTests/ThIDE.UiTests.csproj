<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end UI tests: launch the real ThIDE process with its opt-in UI-automation server
    (THIDE_UI_AUTOMATION=1) and drive it over MCP. Every test is skipped unless THIDE_UI_TESTS=1, so
    `dotnet test ThIDE.sln` stays a unit-test run; tests/run-ui-tests.sh sets it up (on Linux inside a
    private Xvfb display + D-Bus session).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Launched as a separate process; build it, don't link it. -->
    <ProjectReference Include="..\..\ThIDE\ThIDE.csproj" ReferenceOutputAssembly="false" />
    <!-- McpEndpoint: the discovery-file format the automation server writes. -->
    <ProjectReference Include="..\..\src\Therion.Mcp\Therion.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ThIDEDll</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../ThIDE/bin/$(Configuration)/net8.0/ThIDE.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UiFixtures</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../ui-fixtures</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
