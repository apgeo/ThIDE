<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TherionTestTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Therion.Cave3D\Therion.Cave3D.csproj" />
    <ProjectReference Include="..\..\src\Therion.CaveGeometry\Therion.CaveGeometry.csproj" />
    <ProjectReference Include="..\..\src\Therion.Blender\Therion.Blender.csproj" />
    <ProjectReference Include="..\..\src\Therion.Blender.Execution\Therion.Blender.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Run inside Blender by the scene-probe tests, next to the generated script. -->
    <None Update="SceneProbe\scene_probe.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- For the player tests: a feature module outside the player, and a GLB made of two parts. -->
    <None Update="Player\ExtraModules\*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Player\two_part_glb.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Player\draft_colours.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Player\annotation_parts.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Player\reveal_strips.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixed-seed runner for the generated-input tests. -->
    <Compile Include="..\Shared\Properties\*.cs" LinkBase="Shared\Properties" />
  </ItemGroup>

</Project>
