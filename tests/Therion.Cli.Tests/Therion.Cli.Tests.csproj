<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Therion.Cli is an Exe; suppress the "referencing an executable" hint. -->
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Therion.Cli\Therion.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The write-path fixture matrix, shared by every test project that has a writer to check. -->
    <Compile Include="..\Shared\WritePath\*.cs" LinkBase="Shared\WritePath" />
    <!-- Invented caves for the render-bundle tests: no surveyed data. -->
    <Compile Include="..\Therion.Blender.Tests\SceneProbe\InventedCave.cs" Link="Blender\InventedCave.cs" />
  </ItemGroup>

</Project>
