<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TherionTestTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Therion.Core\Therion.Core.csproj" />
    <ProjectReference Include="..\..\src\Therion.Syntax\Therion.Syntax.csproj" />
    <ProjectReference Include="..\..\src\Therion.Workspace\Therion.Workspace.csproj" />
    <!-- The scaffold-to-compile tests drive the real compiler through Therion.Build. -->
    <ProjectReference Include="..\..\src\Therion.Build\Therion.Build.csproj" />
    <ProjectReference Include="..\..\src\Therion.Processing.Abstractions\Therion.Processing.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The write-path fixture matrix, shared by every test project that has a writer to check. -->
    <Compile Include="..\Shared\WritePath\*.cs" LinkBase="Shared\WritePath" />
    <!-- The generated-cave model, printer and binder oracle of the Semantics tests, for the renumber,
         fix-all and import properties. -->
    <Compile Include="..\Therion.Semantics.Tests\Properties\CaveGen\*.cs" LinkBase="Shared\CaveGen" />
  </ItemGroup>

</Project>
