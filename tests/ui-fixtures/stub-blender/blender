#!/usr/bin/env python3
# A stand-in for Blender in the UI tests: answers the version probe, and for a run writes a small
# file where the scene would have been rendered and prints the progress lines the real run prints.
# The application gives Blender either a scene plan with the player that plays it, or a generated
# script; the stub reads where the output goes from whichever it was given. It keeps a copy of
# each script, and of each plan, in $THIDE_STUB_BLENDER_SCRIPTS, so a test can check what the
# application made. With THIDE_STUB_BLENDER_FAIL set, a run ends as a Blender that crashed does.
# Started to show a scene in its window (the player's "--build-only"), it renders nothing and
# keeps the plan as built-plan-<n>.json: the name says how it was started.
import json
import os
import re
import shutil
import sys

if "--version" in sys.argv:
    print("Blender 99.0.0 (stub)")
    sys.exit(0)

if os.environ.get("THIDE_STUB_BLENDER_FAIL"):
    print("Error: the stub was told to fail", file=sys.stderr)
    sys.exit(1)


def say(*lines):
    for line in lines:
        print("THIDE:" + line, flush=True)


def write(path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as stream:
        stream.write(b"stub render\n")
    return path


script = sys.argv[sys.argv.index("--python") + 1]
own = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else []
plan_path = os.path.join(os.path.dirname(script), "scene-plan.json")
keep = os.environ.get("THIDE_STUB_BLENDER_SCRIPTS")
if keep:
    os.makedirs(keep, exist_ok=True)
    number = len(os.listdir(keep))
    if os.path.exists(plan_path):
        name = "built-plan-%d.json" if "--build-only" in own else "scene-plan-%d.json"
        shutil.copy(plan_path, os.path.join(keep, name % number))
    else:
        shutil.copy(script, os.path.join(keep, "render-%d.py" % number))

if "--build-only" in own:
    say("phase=scene", "built=1")
    sys.exit(0)

if os.path.exists(plan_path):
    # The player: one stage, or the first (frames) and the second (compose) of two.
    with open(plan_path, encoding="utf-8") as stream:
        plan = json.load(stream)
    output = plan["output"]
    stage = own[own.index("--stage") + 1] if "--stage" in own else "all"
    frames = own[own.index("--frames") + 1] if "--frames" in own else os.path.join(os.path.dirname(plan_path), "frames")
    if stage == "frames":
        write(os.path.join(frames, "frame_0001.png"))
        say("phase=render", "frames=1", "frame=1/1", "done=1")
    else:
        if stage == "compose":
            say("phase=compose")
            if "--keep-frames" not in own:
                shutil.rmtree(frames, ignore_errors=True)
        else:
            say("phase=render")
        extension = "." + output.get("container", "mp4") if output["kind"] == "video" else ".png"
        name = output["baseName"] + ("_0001" if output["kind"] == "frames" else "") + extension
        target = write(os.path.join(output.get("directory", "."), name))
        say("frames=1", "frame=1/1", "output=" + target, "done=1")
    sys.exit(0)

text = open(script, encoding="utf-8").read()
out_dir = re.search(r'^OUT_DIR = "(.*)"$', text, re.M).group(1).encode().decode("unicode_escape")
name = re.search(r'scene\.render\.filepath = os\.path\.join\(OUT_DIR, "([^"]+)"\)', text).group(1)
target = write(os.path.join(out_dir, name.replace("####", "0001")))
say("phase=render", "frames=1", "frame=1/1", "output=" + target, "done=1")
