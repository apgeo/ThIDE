<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TherionLibraryTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Therion.Blender.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Therion.Cave3D\Therion.Cave3D.csproj" />
    <ProjectReference Include="..\Therion.CaveGeometry\Therion.CaveGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema of the scene plan, for programs that write one without this library. -->
    <EmbeddedResource Include="Plan\scene-plan.schema.json" LogicalName="plan/scene-plan.schema.json" />
  </ItemGroup>

  <!--
    Blender presentations of 3-D cave models: the scene description and its validation and
    serialization, the camera and label planners, the Python script generator, presets, the scene
    metadata, and model-source resolution. Pure: it writes scripts and data, and starts no process
    (Therion.Blender.Execution runs Blender). Models come from Therion.Cave3D, meshes from
    Therion.CaveGeometry.
  -->

</Project>
