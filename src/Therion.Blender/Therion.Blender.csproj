<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TherionLibraryTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Therion.Blender.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Therion.Cave3D\Therion.Cave3D.csproj" />
    <ProjectReference Include="..\Therion.CaveGeometry\Therion.CaveGeometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The player (Python that builds a Blender scene from a scene plan) and the plan's schema.
         They are written out beside a plan; nothing in this assembly runs them. -->
    <EmbeddedResource Include="Player\render.py" LogicalName="player/render.py" />
    <EmbeddedResource Include="Player\single_file.py" LogicalName="player/single_file.py" />
    <EmbeddedResource Include="Player\thide_player\**\*.py" LogicalName="player/thide_player/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Plan\scene-plan.schema.json" LogicalName="plan/scene-plan.schema.json" />
    <!-- The run scripts of a render bundle (RenderBundleWriter). -->
    <EmbeddedResource Include="Player\bundle\render.sh" LogicalName="bundle/render.sh" />
    <EmbeddedResource Include="Player\bundle\render.cmd" LogicalName="bundle/render.cmd" />
  </ItemGroup>

  <!--
    Blender presentations of 3-D cave models: the scene description and its validation and
    serialization, the camera and label planners, the Python script generator, presets, the scene
    metadata, and model-source resolution. Pure: it writes scripts and data, and starts no process
    (Therion.Blender.Execution runs Blender). Models come from Therion.Cave3D, meshes from
    Therion.CaveGeometry.
  -->

</Project>
