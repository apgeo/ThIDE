<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A survey derived from a 3-D model that carries none: the void inside a mesh or a scan, its
    distance field and curve skeleton, stations and legs placed along it (with optional stations and
    legs given by the user), lateral galleries chosen for coverage, splays cast against the model,
    and the Therion centreline text with its provenance. Pure: references only Therion.Cave3D and
    Therion.CaveGeometry, starts no process, so other applications can take it as it is.
  -->

  <PropertyGroup>
    <TargetFrameworks>$(TherionLibraryTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Therion.MeshSurvey.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Therion.Cave3D\Therion.Cave3D.csproj" />
    <ProjectReference Include="..\Therion.CaveGeometry\Therion.CaveGeometry.csproj" />
  </ItemGroup>

</Project>
